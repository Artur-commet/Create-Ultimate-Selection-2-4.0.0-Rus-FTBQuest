{
	chapter.09FBD576F87881B4.title: "Create Ore Excavation"
	chapter.1CFC7955957D28B7.title: "Create Central Kitchen"
	chapter.1E0B14B8BEAE3175.title: "Create Stuff 'N Additions"
	chapter.21FFEEC5D27A5737.title: "Steel Age"
	chapter.23983F4DC524B14B.title: "Mekanism"
	chapter.274D317B89DAB373.title: "Immersive Engineering"
	chapter.4206A58542561BF0.title: "Create Connected"
	chapter.49EA4A06D4508740.title: "Applied Energistics 2"
	chapter.54D57FF8C31ABBAE.title: "Chemicals"
	chapter.5C3FF9D1ECAC4860.title: "Create"
	chapter.66F98B6CCBBBF2A2.title: "Create Crafts \\& Additions"
	chapter.7332B6BB3E51839A.title: "Big Voltage"
	chapter_group.0015B593B4889A40.title: "Technology"
	chapter_group.181E781F1BAE7410.title: "Create"
	chapter_group.4A842940CEB7DFFB.title: "Create TFMG"
	file.0000000000000001.title: "Create Ultimate Selection 2"
	quest.00654F576522DDCA.quest_desc: [
		"A gearbox with shafts on all 6 sides."
		"Top and bottom spin at half speed."
	]
quest.00654F576522DDCA.quest_desc: [
	"Редуктор с валами со всех 6 сторон."
	"Верх и низ вращаются с половинной скоростью."
]

quest.006A26D253D4D1C2.quest_desc: [
	"&6Реактивный ранец&r — предмет, позволяющий игроку летать. Экипируется в слот нагрудника."
	""
	"Использует газ &3Водород&r в качестве топлива и может хранить до &o&b24 000 mB&r."
]

quest.00ACD837E30165B3.quest_desc: [
	"Генерирует кинетическую энергию из FE. Позволяет связать электрические моды с кинетическими системами Create."
]

quest.00C88180C14B1A91.quest_desc: [
	"Используется вместе с &6Spatial IO Port&r для хранения пространственных регионов."
]

quest.00EFC7B327E79076.quest_desc: [
	"После сжигания триллионов энергии в &dSPS&r мы наконец можем создавать &5Антиматериальные пеллеты&r."
	""
	"Пропусти полученный в &dSPS&r &3Газ антиматерии&r через &2Химический кристаллизатор&r, и ты получишь &o&b1&r &5Антиматериальную пеллету&r за каждые &o&b1 000 mB&r."
]

quest.0104893F8F3458DA.quest_subtitle: "ПКМ по стальному корпусу тяжёлой пластиной"

quest.0149B3F7F08D7E35.quest_subtitle: "Крафтовый компонент"

quest.01C3B23461807007.title: "&dУльтимативная механическая труба"

quest.01E0820861BE3E93.quest_desc: [
	"Ультимативный бур, выкованный из мощного незерита для максимальной прочности и долговечности. С лёгкостью разрушает самые твёрдые блоки и идеально подходит для продвинутой автоматизации и поздней стадии игры."
]

quest.0203D270DDDC7E84.quest_subtitle: "Создаётся распылением креозота по доскам"

quest.0221FE72F998600E.quest_subtitle: "Аддон к Create, добавляющий удобные блоки, которых всегда не хватало"

quest.02D05B1D0B266578.quest_desc: [
	"Получив сталь, ты можешь ускорить доменную печь, создав для неё эти усиливающие стенки."
]

quest.037B8971900F3840.quest_desc: [
	"The Factory Must Grow (сокр. TFMG) — аддон для Create. Он добавляет заводские структуры, процессы и предметы, такие как сырая нефть, сталеплавка и различные электрические компоненты."
	""
	"TFMG расширяет стимпанковский стиль Create до более индустриального, дизельпанковского этапа развития."
	""
	"Мод добавляет процессы перегонки нефти путём кипячения сырой нефти в различные фракции, такие как дизель и бензин. Дизель можно использовать для масштабируемых дизельных двигателей или перерабатывать нафту в этилен и пропилен для пластика и охлаждающей жидкости. Из бензина, серной кислоты и алюминия можно делать напалмовые бомбы, чтобы «разыгрывать» друзей — но не пробуй это дома!"
]

quest.0488989FD7F5AF42.quest_desc: [
	"Получается при прокатке железного слитка в прокатном стане."
]
quest.0488989FD7F5AF42.quest_subtitle: "Крафтовый компонент"

quest.04E2D539E33B7B0F.quest_desc: [
	"Химический инфузор объединяет два газа, создавая третий. Левые и правые индикаторы — входные баки, центральный — выходной."
	""
	"Без улучшений потребляет 200 J/t и работает раз в тик. Каждое улучшение скорости удваивает производительность, вплоть до 256 операций/тик."
]

quest.062051ED6D130ACD.quest_desc: [
	"Сталь используется почти во всём TFMG — производи её в больших количествах."
	""
	"Не загружай более стака каждого ингредиента за раз. Также есть шанс, что коксовая пыль не будет израсходована."
]

quest.066FA99DD39A0BF4.quest_desc: [
	"Положи магнитный сплав на громоотвод во время грозы и дождись удара молнии. Трезубцы с «Грозой» тоже подходят."
	""
	"Выход составляет примерно 50%."
]

quest.068728DE3B9B13C3.title: "&dСверхкритический фазовый сдвигатель"
quest.068728DE3B9B13C3.quest_desc: [
	"&aСверхкритический фазовый сдвигатель&r (SPS) — мультиблок для насыщения &3Полония&r огромным количеством энергии с целью создания &dАнтиматерии&r."
	""
	"Для постройки SPS потребуется &o&b72&r &9корпуса SPS&r (60 для структуры и 12 для портов), &o&b3&r &eпорта SPS&r, &o&b122&r &3реакторного стекла&r и ещё один компонент, о котором пойдёт речь в следующем квесте."
]

quest.0696B725E840B996.title: "Взаимодействие с ядерным реактором"
quest.0696B725E840B996.quest_desc: [
	"Чтобы что-либо вводить или выводить из &6Ядерного реактора&r, нужны &aПорты реактора&r. Их можно настроить на &9ввод&r или &cвывод&r с помощью &dКонфигуратора&r."
	""
	"Каждому реактору требуется минимум &o&b4 порта&r:"
	""
	"&o&b1&r ввод охлаждающей жидкости"
	"&o&b1&r вывод охлаждающей жидкости"
	"&o&b1&r ввод делящегося топлива"
	"&o&b1&r вывод отходов"
	""
	"Для начальной сборки размести порты по сторонам и настрой их правильно."
]

quest.06CA244E47D9C097.quest_desc: [
	"&2QIO-панели&r позволяют взаимодействовать с содержимым &9QIO-массива дисков&r."
	""
	"Интерфейс похож на сундук, но поддерживает поиск, сортировку и отображает все предметы одного типа в виде одного стака."
	""
	"Чтобы получить доступ к массиву, панель должна быть настроена на ту же &o&bчастоту&r."
]

quest.06E2A9904675C5C2.quest_desc: [
	"Требуется стальной чан с нагревом. Создаётся из нафты, но оба продукта существуют недолго."
]

quest.06E39E99E00A5283.quest_desc: [
	"Требует очень точного тайминга редстоуна, чтобы извлечь этилен до его превращения в пластик."
	""
	"Охлаждающая жидкость в основном используется для повышения эффективности модульных двигателей."
	"Подумай, стоит ли оно затраченного времени."
]

quest.06E5134C2F756BED.quest_desc: [
	"Ходят слухи, что убийство Дракона Края револьвером — весёлый челлендж. За это можно получить Shader Grabbag — источник шейдеров для кастомизации револьвера."
]
quest.075E97B2BB5F93DF.quest_desc: ["Игрок не может напрямую добавлять или забирать предметы, но это могут делать такие компоненты, как желоба, воронки и предметные люки."]

quest.07AD45DCF9EE3C2E.quest_desc: [
	"&9Установщики уровней&r используются для улучшения различных машин до их &3Фабричных&r версий."
	""
	"&aКликните ПКМ&r по машине с помощью &9Установщика уровня&r, и она будет улучшена до &3Фабрики&r — её уровень (Базовый, Продвинутый или Элитный) зависит от уровня используемого установщика."
	""
	"&aБазовые установщики&r можно применять к любой машине, у которой есть версия &3Фабрики&r и которая ещё не была улучшена."
	""
	"Однако &4Продвинутые установщики&r можно использовать только на &aБазовых фабриках&r, &9Элитные&r — только на &4Продвинутых фабриках&r, а &dУльтимативные&r — только на &9Элитных фабриках&r."
	""
	"Это сделано для того, чтобы игрок не мог &nпропускать уровни&r в &b&о цепочке улучшений&r, например, мгновенно перейти от &aБазовой фабрики&r к &dУльтимативной&r."
]

quest.07ECC87DFF2D3991.quest_desc: [
	"Правильно собранная &9Индукционная матрица&r один раз испустит &cкрасные частицы&r при установке последнего блока, а также будет иметь интерфейс при &eклике ПКМ&r по блоку."
	""
	"Чтобы &9Индукционная матрица&r работала корректно, необходимо настроить один &2Индукционный порт&r на &9вход&r и один на &cвыход&r с помощью &dКонфигуратора&r."
	""
	"Не бойтесь улучшать матрицу, используя ячейки &aвысших уровней&r и &eпровайдеры&r! Максимальный размер структуры &9Индукционной матрицы&r — &o&b18x18x18&r."
]

quest.07ECC87DFF2D3991.title: "&bЗавершённая индукционная матрица"

quest.07EF8ABA0027BB91.quest_desc: [
	"Используются для создания соединения между двумя квантовыми сетевыми мостами и всегда производятся попарно. Чтобы создать соединение, поместите по одной квантово-запутанной сингулярности из пары в ME Quantum Link Chamber каждого моста."
	""
	"Создаются путём вызова реакции между жемчугом Края или пылью Края"
	"и сингулярностью. Любая взрывная сила подойдёт для запуска реакции."
]

quest.0834527ED1C0E83B.quest_desc: ["Позволяет переносить FE внутрь и использовать её в контрапциях Create."]

quest.08DDE018A804BFE7.quest_desc: [
	"Эта машина использует энергию для извлечения пыли из некоторых блоков и руд, что делает её необходимой для производства различных инструментов. Не путайте с дробилкой — это аналог пульверизатора из других модов."
	""
	"Также может использоваться для превращения угля или древесного угля в сжатый углерод, редстоуна — в сжатый редстоун, алмаза — в сжатый алмаз, а очищенной обсидиановой пыли — в сжатый обсидиан для использования в металлургическом инфузоре."
	""
	"Примечание: сжатый углерод стоит 100 единиц углерода; уголь — 10, древесный уголь — 20. Поэтому выгоднее перерабатывать уголь и использовать сжатый углерод."
]

quest.08DDE018A804BFE7.quest_subtitle: "Разбивает необработанные руды на пыль"

quest.0933E0EF37133C32.quest_desc: [
	"Используя стол схем, вы можете создавать гораздо более компактные логические цепи. Для этого понадобятся задняя панель, вакуумные лампы и припой, например, блейд или медные провода. Также стол должен получать энергию через вход сзади."
	""
	"Используя различные компоненты, вы выбираете шаблон схемы, задаёте входные значения и определяете выход. Доступные входы и выходы — это 16 цветных каналов редстоун-провода, а также 8 «регистров»."
]

quest.09408C6DCAC90318.quest_desc: [
	"&4Энергетический куб&r — это продвинутый тип аккумулятора, совместимый с несколькими энергетическими системами."
	""
	"&cЭнергия&r может подаваться с &o&b5&r сторон и выводиться с &o&b1&r стороны. Выходная сторона имеет специальную отметку в виде &nнебольшой панели&r."
	""
	"Поверните куб, &eкликнув ПКМ&r с &aгаечным ключом&r."
	""
	"&4Энергетические кубы&r можно переносить, &aзажав Shift и кликнув ПКМ&r с &eключом&r. Куб «сломается», но вся энергия будет &nбезопасно сохранена внутри&r."
	""
	"Когда куб находится в вашем &eинвентаре&r, &nудержание Shift&r покажет дополнительную информацию об уровне энергии."
]

quest.095E1C928584FAAC.quest_desc: [
	"&9Свободные бегуны&r — это предмет, позволяющий автоматически подниматься на уклоны в 1 блок (как лошадь), а также предотвращать &cурон от падения&r, пока они заряжены. Падение уменьшает заряд в зависимости от высоты."
	""
	"&9Свободные бегуны&r можно заряжать в различных генераторах и накопителях энергии, таких как &aПродвинутый солнечный генератор&r или &2Энергетический куб&r."
]
quest.09BE3D92053AE1F8.quest_desc: [
	"При попытке установить валец на верхнюю грань блока он будет размещён на один блок выше — аналогично &6Механическому миксеру&r или &6Механическому прессу&r. Несмотря на то что он визуально занимает несколько блоков, фактически он занимает только один."
	"Также имеется функция помощи при размещении, позволяющая легко устанавливать вальцы с одной из двух сторон уже установленного вальца."
	"Валец можно подобрать, &eзажав Shift&r и используя &aгаечный ключ&r."
]

quest.09C334C044BC464F.quest_desc: [
	"Отводите CO₂, иначе он будет накапливаться и заблокирует работу. Башню можно сделать выше двух блоков, но это не даёт никакого эффекта."
	""
	"Воздух собирается через воздухозаборники, которым требуется вращение для начала работы. Они могут быть мультиблоками 1x1, 2x2 или 3x3. Энергию они не потребляют, так что ускоряйте их сколько угодно."
	""
	"Топливо (креозот или доменный газ) подаётся в нижнюю грань."
	""
	"Воздух (собранный воздухозаборниками) подаётся в боковую грань нижнего блока."
	""
	"CO₂ выводится через боковые грани нижнего блока."
	""
	"Горячий воздух выводится через верхнюю грань башни."
]

quest.09C334C044BC464F.title: "Доменная плита"

quest.0A0D08D0032BAF5B.quest_desc: [
	"Использует железо и коксовый уголь для производства стальных слитков и шлака."
	""
	"В отличие от примитивной доменной печи, предметы можно автоматически подавать и извлекать."
	""
	"Шлак выводится с задней стороны, предметы загружаются сверху, а &6Преднагреватели доменной печи&r можно разместить по бокам для ускорения производства."
]

quest.0A0D08D0032BAF5B.title: "Улучшенная доменная печь"

quest.0AD6897A8AB1CC5D.quest_desc: [
	"Используется для проверки количества нефти в залежи."
]

quest.0ADA2391DDE7466E.quest_desc: [
	"Продвинутый блок управления, который регулирует работу двигателя и выходную мощность. Оптимизирует эффективность, контролирует скорость и обеспечивает стабильную работу сложных механических систем."
]

quest.0AE0E5AA8FB69FE2.quest_subtitle: "Гаджеты на все случаи жизни"
quest.0AE0E5AA8FB69FE2.title: "Добро пожаловать в Create: Connected"

quest.0AE4B0BD9B765D60.quest_desc: [
	"Установите поверхностный сканер поверх входа машины и подайте на него энергию."
	""
	"25 индикаторов сверху показывают 25 ближайших чанков, при этом центральный индикатор соответствует чанку, в котором находится сканер. Индикатор загорается, если в чанке обнаружена хотя бы одна нефтяная залежь."
	""
	"На этом подсказки заканчиваются — пора начинать копать!"
]

quest.0AEDFC064B84C877.quest_desc: [
	"Автокрафт — одна из ключевых функций AE2. Вместо того чтобы вручную создавать нужное количество каждого промежуточного ингредиента, вы можете поручить это своей ME-системе. Она может крафтить предметы по запросу, автоматически изготавливать и экспортировать их, либо поддерживать заданные запасы за счёт продуманной автоматизации."
	""
	"Автокрафт также работает с жидкостями, а при наличии аддонов — и с другими типами материи, например газами Mekanism. Это действительно мощная система."
	""
	"Тема довольно сложная, так что пристегнитесь — начинаем."
	""
	"{@pagebreak}"
	"Система автокрафта состоит из трёх частей:"
	""
	"Источник запроса на крафт"
	"Крафтовый CPU"
	"Поставщик шаблонов ME"
	""
	"Процесс выглядит так:"
	""
	"Что-то создаёт запрос на крафт. Это может быть игрок в терминале, нажавший на доступный для автокрафта предмет, либо экспортная шина или интерфейс с картой крафта."
	"(ВАЖНО: используйте клавишу «взять блок» — обычно это средняя кнопка мыши — для запроса крафта предметов, которые уже есть в системе; это может конфликтовать с модами сортировки инвентаря)."
	"ME-система рассчитывает необходимые ингредиенты и этапы крафта и сохраняет их в выбранном крафтовом CPU."
	""
	"Поставщик шаблонов ME с нужным шаблоном отправляет указанные ингредиенты в соседний инвентарь. Для рецептов верстака (\"шаблон крафта\") это будет молекулярный сборщик. Для некласcических рецептов (\"шаблон обработки\") — другая машина, блок или сложная схема с редстоуном."
	""
	"Результат крафта возвращается в систему — через импортную шину, интерфейс или возврат в поставщик шаблонов. Обратите внимание: должен произойти факт «предмет вошёл в систему»; нельзя просто отправить результат в сундук с ME-шиной хранения."
	""
	"Если этот крафт является промежуточным шагом для другого, предметы временно хранятся в крафтовом CPU и затем используются дальше."
]

quest.0AEDFC064B84C877.title: "Автокрафт"

quest.0B281C34E455EE72.quest_desc: [
	"Просто увеличенная версия насосной вышки."
]

quest.0B2DF0B5F4247A3F.quest_desc: [
	""
	"Предметы загружаются в ферментер через два люка сзади, отмеченные синими точками. Люк с оранжевой точкой служит для вывода предметов, а блок под ним — для вывода жидкостей."
	"Подача сигнала редстоуна на панель управления спереди остановит процесс; это поведение можно инвертировать с помощью &6Отвёртки инженера&r."
]

quest.0B2DF0B5F4247A3F.title: "Ферментер"

quest.0B7FFB9FF90F10CF.quest_subtitle: "Вкуснятина"

quest.0B8148DAF5CC9DF1.quest_desc: [
	"Высокий ток"
]

quest.0BBE6CADED48A971.quest_desc: [
	"Нажмите ПКМ по складской связке с помощью &6Биржевого тикера&r, чтобы подключить её к сети. Посадите моба в сиденье или установите &6Горелку ифрита&r за тикером, чтобы превратить его в &eХранителя склада&r."
	""
	"Хранитель склада видит все предметы в сети. Интерфейс показывает количество подключённых складских связок. Если хранитель не заблокирован, игроки могут искать предметы, заказывать их и назначать адрес доставки."
	""
	"Если хранитель заблокирован, другие игроки не смогут открыть его интерфейс. При этом он всё равно сможет принимать списки покупок."
]

quest.0C8F501F6BDFFB92.quest_desc: [
	"Получается при прокатке золотого слитка в прокатном стане."
]

quest.0C8F501F6BDFFB92.quest_subtitle: "Крафтовый компонент."

quest.0D158BAE5A38798A.quest_desc: [
	"Позволяет игроку летать, быстрее передвигаться и плавать. Работает в воде."
]

quest.0DA65A502C57261C.quest_desc: [
	"Как и любую другую контрапцию Create, к насосной вышке можно приклеить практически что угодно с помощью суперклея, при условии что основная стрела полностью собрана."
]

quest.0DA972D85BB3C86C.quest_desc: [
	"Коксовая печь — это мультиблоковая машина из мода Immersive Engineering. Она перерабатывает уголь в коксовый уголь, производя креозот как побочный продукт."
	""
	"Коксовая печь может производить древесный уголь, коксовый уголь или блоки коксового угля. Брёвна превращаются в древесный уголь, уголь — в коксовый уголь, а угольные блоки — в блоки коксового угля."
	""
	"Коксовый уголь переплавляет 16 предметов, а блок коксового угля — 160 предметов."
	""
	"Коксовый уголь также используется как топливо в примитивных и улучшенных доменных печах, так как обычный уголь они не принимают."
]

quest.0DA972D85BB3C86C.quest_subtitle: "Горячая тема!"
quest.0DA972D85BB3C86C.title: "Коксовая печь"

quest.0E547F2503A07ACE.quest_desc: [
	"Прочный механический бур из железа, предназначенный для эффективной добычи и переработки ресурсов. Обладает надёжной мощностью и долговечностью, отлично подходит для автоматизации раскопок и разрушения твёрдых блоков."
]

quest.0E580153F1936699.quest_desc: [
	"Мощная машина, преобразующая избыточную энергию или предметы в хранимую материю. Необходима для создания сингулярностей и других высокоуровневых материалов, используемых в продвинутых системах хранения и автоматизации."
]

quest.0E5FC39E6C71A872.quest_desc: [
	"Вал — это базовый механический компонент в Create. Он используется для соединения механических компонентов, передавая вращение от одного к другому, и является единственным блоком, на который можно устанавливать механические ремни."
]

quest.0E5FC39E6C71A872.title: "Вал"

quest.0E63C1AD9074987E.quest_desc: [
	"Расплавьте кварц в доменной печи и отлейте получившийся жидкий кремний."
]

quest.0E9258C07CDD7385.quest_desc: [
	"Гаечный ключ, изготовленный из кристалла кварца Цертус или незер-кварца."
	""
	"Полезен для поворота блоков и снятия отдельных частей кабелей."
]
quest.0EE2E9EB6DC01E34.quest_subtitle: "Крафтовый компонент"
quest.0EEA8C33BC327CCA.quest_desc: ["Терминал доступа к шаблонам предназначен для решения конкретной проблемы: в плотной башне из ME-поставщиков шаблонов и молекулярных ассемблеров к ним невозможно физически добраться, чтобы вставить новые шаблоны. Кроме того, возможно, вам просто лень идти через всю базу ради этого. Терминал доступа к шаблонам позволяет получить доступ ко всем поставщикам шаблонов в сети."]
quest.0FF852DE33E41C90.quest_desc: [
	"Если мы хотим создавать огромные объёмы &4энергии&r, нам понадобится способ всё это хранить, и &aэнергетические кубы&r с этим не справятся."
	""
	"Мы создадим настраиваемый мультблок для хранения большого количества энергии, но сначала нам нужно сделать &3литиевую пыль&r!"
	""
	"У тебя уже должен производиться &eрассол&r из предыдущего квеста с использованием &cтермальных испарительных установок&r."
	""
	"Пропусти &eрассол&r через ещё одну &cтермальную испарительную установку&r, чтобы получить &7литий&r, затем через &9химический кристаллизатор&r, чтобы получить &aлитиевую пыль&r."
]
quest.0FF852DE33E41C90.title: "Продвинутое хранилище энергии"
quest.1065B5980FAF5937.quest_desc: [
	"Подай сырую нефть в контроллер дистилляции и собирай продукты с каждого выхода."
	""
	"Требуется нагрев от Blaze Burner. Стальные резервуары могут быть размером 1x1, 2x2 или 3x3 — больший размер позволяет обеспечить больший нагрев, увеличивая скорость перегонки."
	""
	"Башня минимальной высоты имеет три выхода и производит тяжёлую нефть, дизель и бензин."
	""
	"Добавление ещё двух выходов позволяет получать LPG и керосин."
	""
	"Добавление ещё одного выхода позволяет извлекать нафту."
	""
	"Выходы можно настроить на удаление излишков жидкости или остановку переработки при заполнении, чтобы не тратить нефть впустую."
]
quest.1112E4E2CCEB2467.quest_desc: [
	"Теперь у тебя должно быть 5 машин, готовых к переработке руд."
	""
	"Твоя фабрика должна выглядеть примерно так:"
	"Камера химической инъекции → Камера очистки → Дробилка → Камера обогащения → Плавильня."
]
quest.1112E4E2CCEB2467.title: "Рудная фабрика: Уровень 3"
quest.113E1D3C37C63088.quest_desc: ["Получается при прокатке золотого листа в прокатном стане."]
quest.113E1D3C37C63088.quest_subtitle: "Крафтовый компонент."
quest.1188D57C76DBD215.quest_desc: [
	"Потенциометры пропускают заданный процент входного напряжения на выход. В отличие от реальной жизни, они не расходуют энергию."
	""
	"Например, если база запитана на 3 кВ, а освещению требуется всего 150 В, можно выставить потенциометр на 5%. Так лампы не будут потреблять лишние киловатты без пользы."
]
quest.11D8E015814D44F8.quest_desc: ["Устанавливается сверху на чан и принимает различные насадки. Требует вращательной энергии."]
quest.1210C5B720AE249F.quest_subtitle: "Просто раздроби немного земли, наверное."
quest.135E27A19B935CD7.quest_desc: [
	"Кликни ПКМ по цепи цепного конвейера, чтобы задать цель frogport, затем установи frogport. Frogport можно размещать до 4 блоков в сторону и вниз от целевой цепи."
	""
	"Frogport принимает только посылки, соответствующие его адресу. Адрес можно задать ПКМ по установленному frogport или через его интерфейс."
	""
	"Frogport отправляет только посылки, не соответствующие его адресу, если в интерфейсе не включён режим «отправлять только посылки»."
]
quest.138B96B20044ED12.quest_desc: ["Катушка из константановой проволоки, известной своим стабильным электрическим сопротивлением. Используется при создании электронных компонентов и механизмов, требующих точного контроля питания."]
quest.13B495F64F5C9D48.quest_desc: ["Очищенное топливо, получаемое нагреванием угля без доступа кислорода. Горит горячее и дольше обычного угля, идеально подходит для печей, двигателей и тяжёлой промышленной техники."]
quest.13CAA74DEE1F21A3.quest_desc: ["Усиленный контейнер, предназначенный для безопасного хранения и обработки летучих или высокотемпературных веществ. Его жаростойкая конструкция идеально подходит для химических реакций, переработки и промышленного производства."]
quest.140DE53DC0FCD9F4.quest_desc: [
	"Плоскость аннигиляции ломает блоки и подбирает предметы. Она работает аналогично ME-импортной шине, отправляя всё в хранилище сети. Чтобы предмет был подобран, он должен столкнуться с лицевой стороной плоскости — областью она не собирает."
	""
	"Плоскости аннигиляции можно зачаровывать любыми чарами кирки, так что да — можно поставить безумные уровни удачи и автоматизировать переработку руд, если модпак это позволяет. Шёлковое касание работает ожидаемо, эффективность снижает затраты энергии на ломание блока, а прочность даёт шанс не тратить энергию."
	""
	"НЕ ЗАБУДЬ ВКЛЮЧИТЬ FAKE PLAYERS В ПРИВАТЕ ЧАНКА"
]
quest.140EA40A9ABA65DB.quest_desc: ["Улучшенный высокопроизводительный бур, созданный для максимальной эффективности и прочности. Алмазный наконечник позволяет прорезать даже самые твёрдые материалы, делая его идеальным для продвинутой автоматизации и масштабной добычи."]
quest.147FC2959F9FC5F5.quest_desc: [
	"Поезда — это контрапции, которые передвигаются по железнодорожным путям."
	""
	"Сборка"
	"Уложите рельсы и кликните по ним ПКМ с помощью блока станции. Разместите станцию рядом с путями."
	""
	"Кликните ПКМ по станции и выберите «Create Train», чтобы войти в режим сборки (на станции появится синий флаг)."
	""
	"Разместите один или несколько корпусов поезда на путях в местах, подсвеченных синим. Корпуса превратятся в тележки."
	""
	"После сборки все тележки автоматически сцепятся друг с другом в состав поезда."
	" "
	"Разместите блок управления поездом лицом в направлении, указанном станцией. Позади блока управления установите сиденье или Blaze Burner для машиниста."
	""
	"Используйте инструменты крепления блоков, такие как Super Glue, чтобы соединить все части вместе (зелёная подсветка)."
	""
	"По завершении используйте интерфейс станции, чтобы попытаться собрать поезд. Если сборка не удалась, в интерфейсе станции будет показана ошибка. Распространённые ошибки описаны ниже."
]
quest.1482F2D45E8F761D.quest_desc: [
	"Как и большинство мультблоков &dMekanism&r, реакторы могут иметь произвольный размер в зависимости от ваших потребностей. Они должны быть в форме прямоугольного параллелепипеда, с минимальным внешним размером &b&o3 блока&r в ширину, &b&o4 блока&r в высоту и &o&b3 блока&r в глубину. Максимальный размер — &b&o18x18x18&r."
	""
	"Рёбра внешней оболочки &bобязательно&r должны быть сделаны из &aкорпусов реактора деления&r, в то время как грани могут состоять из корпусов, &bреакторного стекла&r, &7портов реактора&r или &3логических адаптеров реактора&r. К ним мы вернёмся позже."
	""
	"А пока давай построим базовый &b&o5x5x5&r &6реактор деления&r!"
]
quest.1482F2D45E8F761D.title: "&3Реактор деления"
quest.14D772808D1BEAE2.quest_desc: [
	"&9Индукционная матрица&r позволяет настраивать объём хранимой энергии и скорость передачи, добавляя внутрь мультблочной структуры &aячейки&r и &eпровайдеры&r."
	""
	"&aИндукционные ячейки&r увеличивают общее количество энергии, которое может быть сохранено."
	""
	"&eИндукционные провайдеры&r увеличивают общую скорость передачи энергии как на вход, так и на выход из &9матрицы&r."
	""
	"Вы можете настраивать количество каждого элемента &b&oвнутри&r мультблока, но вам потребуется &b&oкак минимум&r по одному каждого типа."
	""
	"У них также есть более высокие уровни, увеличивающие общую ёмкость хранения и передачи."
	""
	"{image:kubejs:textures/item/induction_inside.png width:200 height:100 align:1}"
]
quest.14D772808D1BEAE2.title: "Настройка пределов мощности"
quest.14F6CF9A5F807A51.quest_desc: ["Кликните ПКМ по баку с смазкой, чтобы наполнить канистру. Применение к двигателям даёт экономию топлива в 30%."]
quest.1610C8F55F59E82F.quest_desc: [
	"Кварцевое волокно."
	""
	"Компонент, предназначенный для передачи энергии между двумя ME-сетями без обмена чем-либо ещё; также используется для крафта Fluix ME Glass Cable."
]
quest.162CE44400A63575.quest_desc: [
	"Металлургический инфузор — первый шаг в технологической ветке Mekanism. Это машина, используемая для производства стальных слитков, бронзовых слитков, обогащённого сплава и обсидиановых слитков."
	""
	"{@pagebreak}"
	""
	"Инфузия"
	"В фиолетовый слот помещается материал для инфузии в зависимости от рецепта создаваемого предмета:"
	""
	"Редстоун (редстоун, блок редстоуна или обогащённый редстоун)"
	"Алмаз (алмазная пыль или обогащённый алмаз)"
	"Обсидиан (очищенная обсидиановая пыль или обогащённый обсидиан)"
	"Углерод (уголь / древесный уголь или обогащённый углерод)"
	"Олово (оловянная пыль или обогащённое олово)"
	"Биотопливо (биотопливо)"
	"Гриб (красные или коричневые грибы)"
]
quest.162CE44400A63575.quest_subtitle: "Начальная машина"
quest.16665DE6F0921C26.quest_desc: ["Мощный кинетический генератор, преобразующий тепло во вращательную энергию. Используя разницу температур, он обеспечивает стабильный источник энергии для ваших машин и систем автоматизации."]
quest.16A6C47E35F3B9D0.quest_desc: [
	"Как только у нас появится &9изотопная центрифуга&r, мы сможем загрузить в неё &2гексафторид урана&r и создать &3делящееся топливо&r!"
	""
	"Это было не так уж и страшно, правда?"
]
quest.16A6C47E35F3B9D0.title: "&3Делящееся топливо&r"
quest.17709C4D6222244B.quest_desc: ["Соединяет совместимые с Forge Energy блоки проводами для передачи энергии и излучает свет при получении питания."]
quest.177C0E37A35A14F4.quest_desc: [
	"При питании от кинетики:"
	""
	"Начинает вращать прикреплённую структуру, указывая на текущий час. Если перед первой структурой имеется независимая вторая, она будет выполнять роль минутной стрелки."
	""
	"Экран настроек значений доступен с боковой стороны блока и позволяет изменить порядок стрелок или переключиться на 24-часовой формат, аналогичный предмету «Часы»."
]
quest.17953D4234D44C01.quest_desc: [
	"Разместите буровую установку в чанке с найденной рудной жилой и установите на неё бур."
	""
	"Руда или жидкость будут выводиться через выход мультблока."
	""
	"Жидкость можно извлекать через медную трубу."
	""
	"Для работы машине требуется RPM."
]
quest.180206DDBD6B2D59.quest_desc: [
	"Терминал кодирования шаблонов похож на обычный терминал и имеет те же настройки и разделы, но дополнительно оснащён интерфейсом кодирования шаблонов. Он выглядит как интерфейс крафтового терминала, однако эта сетка крафта фактически не выполняет крафт."
	""
	"У вас должен быть хотя бы один такой терминал в дополнение к крафтовому терминалу."
]
quest.1837076B0EA3C11A.quest_desc: [
	"Механический ремень — это механический компонент, передающий вращение и перемещающий предметы и сущности."
	""
	"Для установки ремня требуется как минимум два вала. Установите ремень, кликнув ПКМ по первому валу, а затем по второму. Независимо от длины, расходуется только один механический ремень. Оба вала должны быть направлены в одну сторону."
	""
	"Механический ремень может быть проложен через любое количество валов, расположенных горизонтально, вертикально или по диагонали (45° к оси Y) в одной линии, при отсутствии препятствий и если общая длина не превышает двадцати блоков. Также требуется, чтобы оба вала были направлены в одну сторону."
]
quest.187A3F5B41D1C923.quest_desc: ["Давайте возьмём нашу &2серную кислоту&r и соединим её с &bфлюоритом&r в &9камере химического растворения&r, чтобы получить &bплавиковую кислоту&r."]
quest.187A3F5B41D1C923.title: "&bПлавиковая кислота"
quest.18A75E664BAC6425.quest_desc: ["Энергия выводится через три точки, похожие на медные, на верхней части мультблока. Машину можно выключить, подав сигнал редстоуна на красную точку на передней стороне. У неё нет GUI, поэтому весь ввод и вывод должен выполняться вручную."]
quest.18A75E664BAC6425.title: "Дизельный генератор"
quest.18D88932916C7A98.quest_desc: [
	"Электролитический сепаратор"
	""
	"Электролитический сепаратор подаёт контролируемое количество постоянного тока в жидкость, разрывая связи между её атомами. Этот процесс, известный как электролиз, позволяет получать полезные газы из обычных жидкостей."
	""
	"По мере электролиза жидкости полученные газы накапливаются во внутренних баках машины. Если любой из баков заполнится, сепаратор автоматически отключится. Чтобы он продолжал работать, подключите напорные трубы или любую совместимую систему транспортировки газа к обоим бакам."
	""
	"Если вам нужен только один тип газа, вы можете установить вывод ненужного газа в режим Dump, чтобы выпускать его в окружающую среду. Это предотвращает остановку машины при заполнении бака."
	""
	"Вам понадобится несколько таких машин, если вы планируете позже построить фабрику переработки руды 2 уровня. Пока что начните с создания одной и используйте её для электролиза самой базовой жидкости — воды."
]
quest.18D88932916C7A98.quest_subtitle: "Пора разобрать по частям"
quest.18D88932916C7A98.title: "Начало фабрики переработки руды 2 уровня"
quest.191A2F855396BDCD.quest_desc: ["Автоматически пополняет гаджеты и броню, использующие топливо."]
quest.195729280394ABFB.quest_desc: [
	"Осмиевый компрессор используется для создания слитков очищенного обсидиана из пыли очищенного обсидиана и слитков светокамня из пыли светокамня."
	""
	"Он соединяет жидкий осмий (расплавленные осмиевые слитки, помещённые в нижний слот машины) с исходными материалами, создавая соответствующие слитки."
]
quest.19754AE8C11A6317.quest_desc: [
	"Деплойер имитирует действия игрока с блоками или сущностями на расстоянии ровно 2 блоков от себя."
	""
	"В деплойер можно поместить предметы для использования, либо кликнув ПКМ предметом по его руке."
	""
	"Деплойер можно остановить с помощью сигнала редстоуна."
	""
	"Фильтр на боковой стороне деплойера можно настроить так, чтобы использовать только определённые предметы. Фильтр также необходим при использовании деплойера в контрапциях."
	""
	"{@pagebreak}"
	""
	"У деплойера есть 2 слота инвентаря: предмет в руке и один дополнительный внутренний слот. Помимо непригодных предметов, предметы, добытые деплойером, будут перемещены в дополнительный слот для извлечения машинами, в это время деплойер будет приостанавливаться. Игрок не может извлекать предметы из дополнительного слота напрямую."
	""
	"По умолчанию деплойер имитирует правый клик. Его можно переключить на левый клик, кликнув ПКМ по передней стороне с помощью гаечного ключа. В режиме левого клика деплойер может использовать обычные инструменты, такие как кирки и мечи. Инструменты будут вести себя так, как если бы их держал игрок, включая выпадение редких предметов с мобов, убитых деплойером."
]
quest.197AB0E07A40512F.quest_desc: ["Водяное колесо — источник вращательной энергии. Оно генерирует вращающую силу, когда по нему течёт вода."]
quest.19936E26E71B5F68.quest_desc: ["Энергия подаётся через нижнюю грань и выводится через верхнюю."]
quest.19A9DA93FF046BD9.quest_desc: ["Прочная, но лёгкая рама, используемая для обшивки и защиты механических или электрических компонентов. Её надёжность и устойчивость делают её идеальной для создания продвинутых промышленных машин."]
quest.1A61ABEC34369F47.quest_desc: ["Переключатель шестерён, который меняет направление вращения, если не запитан."]
quest.1A72F7DA24E1BB09.title: "&cПродвинутая механическая труба"
quest.1A72F7DA24E1BB09.title: "&cПродвинутая механическая труба"
quest.1A7D9B32BD59417B.quest_desc: [
	"В основном &bдекоративный&r источник &eсвета&r с питанием, который можно прикрепить к &9Fluix ME Glass Cable&r или другим не плотным кабелям."
	""
	"Также используется как &nингредиент&r для крафта."
	""
	"{image:kubejs:textures/item/illuminated_panel.png width:160 height:100 align:1}"
]
quest.1AFBE29BB6CC2C0D.title: "Механические компоненты"
quest.1B04A295850D0F00.quest_desc: ["Наблюдатель поездов используется для обнаружения проезжающих поездов."]
quest.1B65E8BE91A087DA.quest_desc: [
	"После установки цепного конвейера его можно соединить с другими цепными конвейерами, кликнув по ним ПКМ с цепью. Выделение можно сбросить, повторно кликнув по цепному конвейеру."
	""
	"Максимальное расстояние, на котором могут быть размещены цепные конвейеры, составляет 32 блока; если расстояние ровно 32 блока, можно добавить ещё 8 блоков в сторону."
	""
	"Максимальный угол, при котором цепные конвейеры могут соединяться с перепадом высоты, составляет 45°, что даёт примерное соотношение 2 горизонтальных блока к одному вертикальному. Максимально возможный прямой уклон — 30L на 14H от центра к центру."
]
quest.1B6DDF50D00CBB31.quest_desc: [
	"Это способ получения &3стали&r в &dMekanism&r."
	""
	"&3Стальной слиток&r создаётся путём переплавки &3стальной пыли&r в любой печи."
	""
	"Инфузия &7железа&r с &b&o10&r единицами &0углерода&r в &eметаллургическом инфузоре&r даст &7обогащённое железо&r."
	""
	"Инфузия &7обогащённого железа&r ещё с &b&o10&r единицами &0углерода&r даст &3стальную пыль&r,"
	""
	"&3Сталь&r — один из основных компонентов крафта во многих рецептах Mekanism."
]
quest.1B6DDF50D00CBB31.title: "Сталь"
quest.1CB243F7E197B883.quest_desc: ["Отображает задание верхнего уровня и его текущий прогресс, позволяя увидеть, над чем в данный момент работает конкретный крафтовый CPU."]
quest.1CBE8399B440A1FD.quest_desc: ["Мощный многoцилиндровый двигатель, расположенный по кругу для сбалансированного движения и высокого крутящего момента. Его эффективная конструкция обеспечивает сильную и стабильную мощность для продвинутых промышленных машин."]
quest.1D00D782B8F0B6D6.quest_desc: [
	"Механический миксер приводится в действие внутренней шестернёй и ведёт себя как она по отношению к соседним компонентам, передавая и разворачивая вращение вбок."
	""
	"Для работы миксеру требуется минимальная скорость вращения 30 RPM от источника энергии. Чем выше скорость, тем быстрее миксер обрабатывает ингредиенты."
	""
	"Для работы миксер должен быть размещён непосредственно над чаном с зазором в 1 блок. Когда в миксер загружается корректный рецепт путём броска ингредиентов, он автоматически объединяет их."
]
quest.1D0939A8B41C72BF.quest_desc: [
	"Хранит до 200 000 AE."
	""
	"Они не принимают питание напрямую, а используются для увеличения запаса энергии уже существующей ME-сети."
]
quest.1D197B1919452187.quest_desc: ["Компактная Redstone Link, добавляющая беспроводной редстоун к кнопкам, рычагам и связанным рычагам."]
quest.1DBA8DD396081924.quest_desc: ["Интерфейсы должны быть размещены лицом друг к другу на расстоянии 1–2 блоков: один на контрапции с жидкостными баками, другой — стационарный. Для закачки или извлечения жидкости из контрапции требуется жидкостный насос. Чтобы перекачивать жидкости в другой бак, просто соедините стационарный интерфейс и бак жидкостными трубами, однако для движения жидкости всё равно необходимы насосы."]
quest.1DCDA89DA49A8EF0.quest_desc: ["Нефтеперерабатывающий завод — это структура, добавленная модом Immersive Engineering. Она использует энергию и смешивает этанол (8 mb) и растительное масло (8 mb) для создания биодизеля (16 mb) — горючего топлива для дизельного генератора."]
quest.1DCDA89DA49A8EF0.title: "НПЗ"
quest.1DE428DE5A0AB47C.quest_desc: ["Когда обработка угля будет завершена, передние дверцы откроются, и угольный кокс будет выброшен вперёд. Рекомендуется разместить там воронки или конвейер, чтобы его собрать."]
quest.1DE8B0C9A7195720.quest_desc: [
	"После того как вы закончите размещение всех необходимых блоков для постройки &6реактора&r, он начнёт испускать &cкрасные&r частицы, показывая, что он &nзавершён&r."
	""
	"&eКлик ПКМ&r по любой части реактора откроет &aинтерфейс&r. В нём содержится вся информация, необходимая для правильной работы &6реактора&r, а также две кнопки для &9включения&r и &cвыключения&r &6реактора&r."
	""
	"Слева находятся &o&b2 бака&r: один для &bохладителя&r и один для &3делящегося топлива&r. Справа — бак для &8ядерных отходов&r и бак для &bнагретого охладителя&r, которым чаще всего будет &bпар&r."
	""
	"Полоса &cтемпературы&r показывает, насколько горяч реактор. После достижения определённой температуры реактор начнёт получать &4урон&r, что в конечном итоге приведёт к его взрыву."
	""
	""
	"{@pagebreak}"
	"Для настройки &cскорости сжигания&r &3делящегося топлива&r и просмотра дополнительных статистик нажмите на вкладку (I) слева. Здесь можно изменить ограничение скорости, которое контролирует, сколько топлива реактор сжигает за тик."
	""
]
quest.1DE8B0C9A7195720.title: "&3Завершённый реактор деления"
quest.1E01AC22D5903AD1.quest_desc: ["Ручные колёса с установленной шестернёй."]
quest.1E1016523BF3849D.quest_desc: ["Переработанный материал, получаемый при дроблении бокситовой руды. Служит ключевым ингредиентом для производства алюминия и других продвинутых промышленных сплавов."]
quest.1E1EF430810D08BF.quest_desc: [
	"&6Солнечный нейтронный активатор&r — машина, направляющая нейтронное излучение солнца во внутренний резервуар, позволяя медленно создавать различные изотопы."
	""
	"&9Вход&r находится в &o&bнизу&r, &cвыход&r — в &o&bпередней части&r."
	""
	"Ей не нужна &nэнергия&r, кроме &nпрямых солнечных лучей&r, которые могут быть перехвачены прозрачными блоками, такими как стекло, кабели, трубы и т.д."
]
quest.1EBA6436DEBB02CC.quest_desc: [
	"&eME Conversion Monitor&r — улучшенная версия &2ME Storage Monitor&r."
	""
	"Он добавляет возможность &nпрямого&r извлечения или хранения &aпредметов&r в &dME сеть&r."
	""
	"Помимо функций &2Storage Monitor&r, монитор конверсии поддерживает следующие действия:"
	""
	"&bЛКМ&r &nИзвлекает&r стек отображаемого предмета в &nваш инвентарь&r"
	""
	"&bПКМ&r с &eпредметом&r &nВставляет&r удерживаемый предмет в &nсеть&r"
	""
	"&bПКМ&r с &7пустой рукой&r &nвставляет&r все отображаемые предметы из &nвашего инвентаря&r в &nсеть&r."
]
quest.1F36CF5D11E08839.quest_desc: ["Соединяет блоки, совместимые с Forge Energy, проводами для передачи энергии."]
quest.1F980CFE55E589A6.quest_desc: [
	"Промышленный пресс — 3x3x3 мультблок, добавленный Immersive Engineering. Используется для получения растительного масла или графитовой пыли HOP."
	""
	"Ниже приведён список предметов, которые можно отжать для получения растительного масла."
	""
	"Семена дыни -> &o&b20&rmB"
	"Семена тыквы -> &o&b40&rmB"
	"Семена томата -> &o&b60&rmB"
	"Семена свёклы -> &o&b60&rmB"
	"Семена пшеницы -> &o&b80&rmB"
	"Семена капусты -> &o&b80&rmB"
	"Семена промышленной конопли -> &o&b120&rmB"
]
quest.1F980CFE55E589A6.title: "Промышленный пресс"
quest.1FAAF8216CDC3AC6.quest_desc: [
	"Подача &0ядерных отходов&r в &9Солнечный нейтронный активатор&r даст &dПолоний&r."
	""
	"Пропустите &dПолоний&r через &2Прессуризованную реакционную камеру&r с небольшим количеством &bФторитовой пыли&r, и вы получите &9Полониевые таблетки&r."
	""
	"Это также создаст побочный продукт — &7Отработанные ядерные отходы&r, которые нужно перекачать в &6Бочку для отходов&r для хранения."
]
quest.1FB657F4DEC4885C.quest_desc: ["Crafting Storage предоставляет от 1k до 265M единиц хранения для крафта."]
quest.1FC7E9DBF92BE6AA.quest_desc: ["Энергетическая таблетка — портативный аккумулятор, который можно зарядить до 1 000 kJ и использовать для питания других устройств. Также является ингредиентом во многих рецептах."]
quest.1FDBB75ECD39FB24.quest_desc: [
	"Item Drain может содержать до 1500 мб жидкости одновременно. Для извлечения жидкости нужен жидкостный насос."
	""
	"Бассейн автоматически отправляет выходные жидкости в Item Drain, установленный рядом с ним."
]
quest.215D766150B54B17.quest_desc: ["Низкий ток"]
quest.21800FC0CDC937CB.quest_desc: [
	"Генерирует гораздо более высокие напряжения и мощность, чем базовый генератор."
	""
	"Компоненты собираются в механическом крафтере с большим количеством алюминия и стали."
	""
	"Оберните ротор статором, чтобы завершить мультблок."
	""
	"Детали работы:"
	""
	"0 RPM - 70 RPM: Электричество не вырабатывается"
	""
	"71 RPM - 256 RPM: Напряжение линейно увеличивается от 12V до 2232 kV. Ток ограничен до 24,6 A, обеспечивая выходную мощность от 295 W до 54,9 kW"
]
quest.2199F0DE2FBE29E3.quest_desc: [
	"Механическая рука может взаимодействовать с Кастрюлей, Сковородой, Плитой, Разделочной доской, Холодильником, Духовкой."
	""
	"Механическая рука может работать на станциях, где Packager поддерживает распаковку только для слотов контейнеров, так как слоты ингредиентов корректно обрабатываются распаковкой Packager."
]
quest.21A830CC8DAD6566.quest_desc: [
	"ПКМ по железной дороге, затем разместите станцию в пределах 15 блоков от рельса. Она может создавать поезда только на прямом рельсе, а тележки можно разместить только на прямом участке длиной 3 блока."
	""
	"В интерфейсе станции можно дать имя; эти имена позволяют поездам без игрока идентифицировать станции. Кондуктору нельзя задать движение к станции с таким же именем, как текущая станция; в этом случае он выберет ближайшую доступную станцию с таким именем."
	""
	"Имя также будет отображаться на карте, если карта используется на станции, аналогично баннерам."
]
quest.21B40BEC30B40491.quest_desc: [
	"При удерживании воронка препятствует доступу игрока к инвентарям, вместо этого размещая их. ПКМ с зажатым Shift помещает воронку в режим ввода."
	""
	"Использование гаечного ключа на воронке переключает её между режимами ввода и вывода. К редстоуну можно подключить сигнал для остановки ввода или вывода. ПКМ по воронке на механическом конвейере удлиняет её на один блок вперёд."
]
quest.21B40BEC30B40491.title: "Воронка"
quest.21D45D2B85002B6E.quest_desc: ["Густое вещество, напоминающее смолу, получаемое из сырой нефти. Используется как базовый материал для производства асфальта, топлива и других промышленных ресурсов, необходимых для крупных фабрик."]
quest.2239CC2E6B914090.quest_desc: ["Устройство с питанием, которое перемещает жидкости по трубам с использованием электрической энергии. Обеспечивает точный и стабильный поток, идеально подходит для систем автоматизации и промышленного оборудования."]
quest.22AC3C79141AB3FC.quest_desc: ["Получено путем помещения листа электрума в прокатный станок."]
quest.22AC3C79141AB3FC.quest_subtitle: "Ингредиент для крафта."
quest.22C1FDD2FC9A3AC2.quest_desc: [
	"Рецепты можно задавать внутри Ассемблера. Жидкостные баки в Ассемблере автоматически заполняют контейнеры жидкостью, используемые в рецептах, такие как ведра воды."
	""
	"Ассемблер автоматически создаёт установленные рецепты, если есть необходимые материалы. Изготовленные предметы остаются в инвентаре Ассемблера."
	""
	"Если к выходу Ассемблера подключен инвентарь, изготовленные предметы будут перемещены в этот инвентарь."
]
quest.22C1FDD2FC9A3AC2.title: "Ассемблер"
quest.22C5D2CD84E6E9EF.quest_desc: [
	"&dСтанция модификации&r используется для применения модульных улучшений к &3Meka-Suit&r и &aMeka-Tool&r в обмен на энергию."
	""
	"Часть &3Meka-Suit&r (совместимая с улучшением) вставляется в станцию вместе с &aулучшением&r, в результате чего улучшение применяется к &3Meka-Suit&r."
	""
	"Функционирует аналогично &0Наковальне&r или &6Столу модификации силовой брони&r из мода &9Modular Powersuits&r."
]
quest.22C5D2CD84E6E9EF.title: "&eСтанция модификации"
quest.22E01FE041DE9C54.quest_desc: ["Компактный источник энергии, который преобразует давление воды в вращательную энергию. Обеспечивает плавное и стабильное движение, идеально подходит для эффективного управления механическими системами."]
quest.2331FCDD2F2B709A.quest_desc: [
	"&9Сверхзаряженная катушка&r размещается на &3SPS Порте&r в центре двух граней, как показано на изображении ниже. При подаче энергии катушки превращают &dПолоний&r в &5Антиматерию&r. Требуется только &o&b1&r, но можно использовать &o&b2&r, если хотите."
	""
	"Для производства &o&b1mb&r &5Антиматерии&r требуется &o&b400MRF&r энергии. Если вы ещё не начали создание &6Реактора синтеза&r, сейчас самое время!"
	""
	"{image:kubejs:textures/item/sps_coils.png width:200 height:125 align:1}"
]
quest.2331FCDD2F2B709A.title: "Сверхзаряженные катушки"
quest.23A9A2D399A7BF94.quest_desc: [
	"&9Лифт-шкив&r работает похожим образом на &9Верёвочный шкив&r и имеет схожие функции. В отличие от верёвочного шкива, он может проходить сквозь блоки и не превращается обратно в блоки, пока по нему не кликнуть ПКМ."
	""
	"Для сборки лифт-шкива требуется один горизонтальный красный контакт Redstone на конструкции. Если добавлено больше одного контакта, лифт не соберётся. При нарушении условий будет отображено соответствующее сообщение об ошибке при просмотре лифт-шкива."
]
quest.23F165DEAD225B10.quest_desc: ["Универсальные кабели — способ Mekanism передавать энергию."]
quest.23F165DEAD225B10.title: "&aБазовый универсальный кабель"
quest.24174700F7FB771C.quest_desc: [
	"Напомним, мы настроили продвинутый завод по переработке руды с использованием нескольких газов, машин и других элементов."
	""
	"В этой главе мы будем использовать больше этих компонентов для создания мощных мультблоков &aРеакторов&r, а также продвинутых способов создания и хранения энергии. Это также приведёт к созданию &dАнтиматериальных гранул&r и некоторых из самых сильных инструментов и оружия в сборке."
]
quest.24174700F7FB771C.quest_subtitle: "*Открывается после завершения квеста &b&n&oMekanism: Фаза первая&r*"
quest.24174700F7FB771C.title: "Добро пожаловать в&r &dMekanism:&r Фаза вторая"
quest.24CFA0022432887E.quest_desc: [
	"При размещении игроком Переключатель Порогов попытается ориентироваться на соседний инвентарь. Если присутствует несколько или ни одного инвентаря, переключатель может ориентироваться на игрока и быть отрегулирован обычным способом с помощью гаечного ключа. В настоящее время вертикальная ориентация недоступна."
	""
	"Можно установить пороги предметов, чтобы определить, когда красный сигнал включается или выключается. При первом размещении переключатель остаётся выключенным до достижения 75% заполнения инвентаря, затем включается до 25%."
	""
	"{@pagebreak}"
	"Иконка сундука показывает, насколько полон инвентарь, а также текущее состояние сигнала (вкл/выкл) в зависимости от положения иконки в линии. Стрелки показывают пороги инвентаря, визуализируемые перемещением иконки сундука при достижении стрелки."
	""
	"Сигнал можно инвертировать, кликнув по кнопке с двумя противоположными стрелками рядом с нижней полосой порога."
]
quest.24DDED464AE48E05.quest_desc: ["Меняет направление выходной вращательной силы при подаче сигнала Redstone."]
quest.2580602D7B567F11.quest_desc: ["Усиленная рукоять, созданная для продвинутых инструментов, обеспечивающая улучшенный захват, прочность и производительность. Необходима для создания качественных механических инструментов и деталей машин."]
quest.25C93EDEDDF8CBE4.quest_desc: [
	"&2Переключающая шина&r."
	""
	"Шина, работающая аналогично &9Флуикс ME стеклянному кабелю&r или другим &eКабелям&r, но &nпозволяет&r переключать состояние соединения через &красный камень&r."
	""
	"Это позволяет &nотключать&r участок &dME сети&r."
]
quest.261ABBDC3DABD8B3.quest_desc: ["Муфта, соединяющаяся только если вход вращается в правильном направлении, как настроено."]
quest.263220DCCDB90E29.quest_desc: [
	"Для удвоения выхода слитков ваша установка должна выглядеть примерно так:"
	""
	"Сырая руда поступает в Камеру очистки, которая получает кислород из Электролитического сепаратора."
	"Обработанный материал отправляется в Дробилку, превращающую рудные комки в Грязную пыль."
	"Затем Грязная пыль поступает в Камеру обогащения, где превращается в обычную рудную пыль."
	"Наконец, рудная пыль отправляется в Плавильню, производя ваши слитки."
	""
	"Эта система завершает цепочку переработки руды 2 уровня, удваивая выход с каждой руды."
]
quest.263220DCCDB90E29.title: "Завод по переработке руды: Уровень 2"
quest.264E6FD715F41414.quest_desc: ["Стандартный источник энергии, который преобразует топливо или давление в вращательную энергию. Надёжный и универсальный, подходит для питания различных механических систем и фабричных машин."]
quest.26A58E2711BC7B28.quest_desc: [
	"Порт Spatial IO используется для хранения пространственной ячейки и управления операцией Spatial IO."
	""
	"Ячейка может вставляться и извлекаться любыми системами логистики, такими как воронки или шины AE2, если вы хотите автоматизировать процесс."
]
quest.270E0BC2E8565FFE.quest_desc: [
	"Извлекает предметы из инвентаря, на который он направлен, и помещает их в &dME Network&r Networked Storage."
	""
	"Вы можете &nуказать&r, какие предметы он будет вытаскивать через &bUI&r, иначе он попытается извлечь любые предметы из соседнего инвентаря."
	""
	"&aME Import Bus&r попытается импортировать любые возможные предметы, даже если &o1&r или более &nнастроенных&r предметов не могут быть сохранены."
	""
	"&aME Import Bus&r требует &eКанала&r для работы."
	""
	"Это функциональная противоположность &6ME Export Bus&r."
]
quest.2774D37126FE6785.quest_desc: [
	"Направление поршней и конвейерных лент имеет значение. Поршень должен быть направлен вниз. Конвейерные ленты должны двигаться вдоль длины или вверх по машине."
	""
	"После установки блоков используйте Инженерный молоток на поршне с той стороны, где должна быть панель управления, чтобы завершить сборку мультблока."
	""
	"Металлический пресс требует формы для работы. ПКМ по прессу с формой прикрепляет форму к прессу. Форма может быть снята Shift+ПКМ с Инженерным молотком."
]
quest.2774D37126FE6785.title: "Металлический пресс"
quest.27A11A6ED27A72D2.quest_desc: [
	"Трансформаторы могут повышать или понижать напряжение в зависимости от соотношения витков их электромагнитных катушек. Например, катушка входа с 100 витками и катушка выхода с 400 витками дают коэффициент 4, повышая напряжение в 4 раза."
	""
	"Катушки добавляются ПКМ по трансформатору. Катушка входа устанавливается первой, затем катушка выхода."
	""
	"На данный момент нет явного способа отличить вход от выхода, кроме текстуры шума сверху. Трансформаторы не двунаправленные. Верхняя часть \"ручки\" с шахматным узором указывает на вход, который будет слева при размещении блока."
]
quest.28B88FFE1B735E3E.quest_desc: ["Ключевой механический компонент для работы насосной установки. Преобразует вращательную силу в вертикальное движение, позволяя добывать жидкости, такие как нефть, из подземных резервуаров."]
quest.2951D84F8F0F389A.quest_desc: ["Электронный экран, состоящий из отдельных световых сегментов, используемый для отображения чисел или простых символов. Идеален для сборки часов, счётчиков или цифровых индикаторов в продвинутой технике и панелях управления."]
quest.2A2CE255693B7495.quest_desc: ["База двигателя запросит ПКМ для установки каждого требуемого компонента. После добавления всех частей двигатель потребует столько поршней, сколько необходимо для завершения выбранной конфигурации."]
quest.2A404708E175235F.quest_desc: [
	"Жидкости можно хранить и извлекать из баков с помощью жидкостных труб. Трубы могут быть установлены на любой стороне бака: сверху, снизу или сбоку. Окно бака можно переключать с помощью гаечного ключа."
	""
	"Направление потока в трубе показывает, будут ли жидкости поступать в бак или извлекаться из него; если поток направлен к баку, жидкость будет храниться в баке. Если труба течёт от бака (через механический насос), жидкость будет извлекаться из бака в трубу."
]
quest.2A55024C0BA2F4EA.quest_desc: ["&cHyper-Dens QIO Drive&r может содержать &o&b128,000&r &nпредметов&r и &o&b256&r &nтипов предметов&r."]
quest.2A6ECCE28B9C64FB.quest_desc: ["Летающий латунный спутник, который следует за игроком, если у него есть контроллер."]
quest.2ADDA74C73C08DB2.quest_desc: ["Редуктор, у которого направление вращения всех 4 сторон настраивается независимо."]
quest.2AF85A5EE9A8CCBA.quest_desc: ["Муфта, соединяющаяся только если входная скорость RPM выше настроенного порога."]
quest.2B3A70E34CB0CE21.quest_desc: ["Автоматически пополняет гаджеты и броню, использующую топливо."]
quest.2B3F2F470E06BC40.quest_desc: [
	"&6SPS&r будет иметь размеры &o&b7x7&r при сборке, но это не куб. Он следует простому шаблону, который можно использовать по изображениям ниже как руководство. Шаблон выглядит так: "
	""
	"{@pagebreak}"
	"Каждая сторона, включая верх и низ, следует этому шаблону. &dСверхзаряженные катушки&r должны быть размещены напротив друг друга в &o&bцентре&r соответствующих сторон, а оставшиеся два порта используются для подачи &5Полония&r и вывода &3Газа Антиматерии&r."
	""
	"Ниже показана готовая конструкция: "
	""
]
quest.2B3F2F470E06BC40.title: "&dГотовый SPS"
quest.2B6E2CD796D4ADF3.quest_desc: ["Тяжёлый металлический слиток, используемый для создания промышленных компонентов и частей машин. Его плотность и проводимость делают его ценным для продвинутых механических и электрических конструкций."]
quest.2BB30AED452773EB.quest_desc: ["Портативное устройство, позволяющее удалённо получить доступ ко всей сети хранения. Объединяет несколько функций в одном интерфейсе, обеспечивая удобное управление предметами, крафт и мониторинг из любой точки диапазона."]
quest.2CD6597AE3312F20.quest_desc: ["Почти мгновенно формируется в ванне с нефтью-нафтом, поэтому можно считать, что жидкий пластик является прямым продуктом нафты."]
quest.2CD70FCC8B119D7A.quest_desc: ["Коричневые стрелки на насосе показывают направление потока. Направление потока можно изменить с помощью гаечного ключа. При использовании ключа весь клапан кажется повернутым на 180 градусов. Коричневые стрелки появятся на другой стороне шестерни насоса."]
quest.2D94489E09F8DD9C.quest_desc: [
	"Стальной механизм используется во многих машинах."
	""
	"Как и прецизионный механизм, он требует тяжёлой пластины для размещения различных компонентов:"
	""
	"Стальное зубчатое колесо"
	"Никелевая пластина"
	"Большое стальное зубчатое колесо"
	"Свинцовая пластина"
	"Винты"
	"Отвёртка"
	""
	"Делается дважды с шансом 94% получить стальной механизм."
]
quest.2DEF812916A51C34.quest_subtitle: "Найдено в Нижнем мире."
quest.2E10AFB432824AB1.quest_desc: ["Прочный провод из медно-никелевого сплава, ценится за стабильное электрическое сопротивление. Широко используется в продвинутых схемах и точной инженерии."]
quest.2E274BEEF2B0B8C7.quest_desc: [
	"Химический окислитель используется для производства газов из материалов. Это ключевая машина для 5-кратного производства руды Mekanism."
	""
	"Начнём с производства диоксида серы."
	""
	"Подавая серную пыль в Химический окислитель, вы получите диоксид серы."
	""
	"Теперь нужно получить триоксид серы. Отправьте диоксид серы в Химический инфузер, чтобы соединить его с кислородом и получить триоксид серы."
	""
	"Отправьте триоксид в другой Химический инфузер и соедините с водяным паром, чтобы получить серную кислоту."
]
quest.2E8B8DBE61162084.quest_desc: [
	"Их можно фильтровать, чтобы пропускать только определённые предметы, и останавливать с помощью сигнала редстоуна. В отличие от воронок, они могут вставлять и извлекать предметы одновременно, но работают только вертикально."
	""
	"Если находиться прямо под инвентарём, слот фильтра также действует как диод Value Settings, как у латунной воронки. Желоб можно настроить для извлечения до или ровно заданного количества предметов. Настройки Value Settings умного желоба сохраняются даже при разрушении инвентаря сверху, хотя это не влияет на поведение желоба вне инвентаря."
]
quest.2E9FC7DC2AC6FD8E.quest_desc: [
	"&8Ядерные отходы&r можно отправить в &dИзотопную центрифугу&r для производства &9Плутония&r."
	""
	"Отправка &9Плутония&r в &2Камеру прессованных реакций&r с &1Водой&r и &7Флюоритовой пылью&r даст &9Плутониевые гранулы&r."
	""
	"Также создаётся побочный продукт — &7Использованные ядерные отходы&r, которые необходимо перекачивать в &6Бочку отходов&r для хранения."
]
quest.2EF4DD5CC254CC80.quest_desc: [
	"Механическая труба — это жидкостная труба Mekanism."
	""
	"Её можно использовать для подключения к любым блокам с обработкой жидкостей."
]
quest.2EF4DD5CC254CC80.title: "&aБазовая механическая труба"
quest.2F0B0D4401AA455E.quest_desc: [
	"С помощью гаечного ключа можно добавить окна туннеля."
	""
	"Туннель не останавливает обработку предметов на ленте инкапсулированным вентилятором, но блокирует поток воздуха за пределами ленты."
	""
	"Андезитовые туннели также могут использоваться для разделения отдельных предметов от проходящих стопок на боковые выходы."
]
quest.2F0B0D4401AA455E.title: "Туннель"
quest.2F6B432512FA2A65.quest_desc: ["Подключается к любому инвентарю для увеличения площади поверхности. Отлично подходит для доступа в ограниченных пространствах и умных схем с пороговыми переключателями."]
quest.2F74E955A2455025.quest_desc: [
	"Если электрические компоненты подключены напрямую без диодов, они делят между собой напряжение. Чем больше устройств добавлено, тем меньше ток получает каждое. Другими словами, не перегружайте линию, если не хотите наблюдать за тем, как всё выходит из строя."
	""
	"Диоды же (вместе с потенциометрами и трансформаторами) действуют как разветвители цепи. Всё на стороне выхода получает полное напряжение отдельно, чистое, изолированное и готовое к работе."
]
quest.2F8B1B5084313565.quest_desc: [
	"Immersive Engineering — технологический мод."
	""
	"Наиболее известен своими мультблок-машинами с индустриальным видом. Как одиночные, так и мультблок-машины работают на трёх уровнях мощности: низкое напряжение 256 RF/t, среднее 1024 RF/t и высокое 4096 RF/t."
	""
	"Самый важный инструмент — Инженерное руководство, создаваемое из книги и рычага. Содержит рецепты и инструкции ко всему в моде."
]
quest.2F9B52EA41B4DFF0.quest_desc: ["Провод из очищенной меди, используемый для передачи электричества между машинами и компонентами. Необходим для построения энергетических сетей и автоматических цепей."]
quest.302D29E43E9C9A94.quest_desc: [
	"При размещении рядом с любым инвентарём, упаковщики могут создавать картонные упаковки из подключённого инвентаря. Для этого не требуются дополнительные материалы."
	""
	"При подаче сигнала редстоуна упаковщик старается заполнить упаковку максимально. Картонная упаковка имеет 9 слотов инвентаря. Размещая на упаковщике подписанный знак, вы назначаете адрес для создаваемой упаковки."
]
quest.30A84C6A54BD336E.quest_desc: [
	"Стационарный механический бур разрушает блоки перед собой за время (45 x Твёрдость)/RPM и наносит урон сущностям вокруг."
	""
	"Механический бур на подвижном устройстве разрушает блоки и наносит урон сущностям при столкновении без прямого источника вращательной силы."
	""
	"Время разрушения блока механическим буром зависит от скорости устройства и значения Твёрдости блока. Урон сущностям также зависит от скорости устройства."
]
quest.30B3469DAA8D5A0A.title: "&cПродвинутый логистический транспортер"
quest.30D6BFA1A3B6B205.quest_desc: ["Редуктор, у которого направление вращения всех 4 сторон настраивается независимо."]
quest.316399F0B5F729CA.quest_desc: ["Может использоваться как обычный верстак. Кроме того, имеет 18 слотов хранения и сохраняет предметы, которые вы положили внутрь."]
quest.31EEE2875595F315.quest_desc: [
	"Вы уже должны были сделать &2Серную кислоту&r для вашего &b&oФабрики переработки руды 4 уровня&r, но вот напоминание, как её получить."
	""
	"Начните с получения &eСерной пыли&r — либо дроблением серы из &9Thermal&r, либо смешиванием &bХлористого водорода&r с &3Порохом&r в &dХимической камере растворения&r."
	""
	"Возьмите &eСерную пыль&r и пропустите через &9Химический окислитель&r, чтобы получить &eДиоксид серы&r. Соедините его с &bКислородом&r в &cХимическом инфузере&r, чтобы получить &eТриоксид серы&r."
	""
	"Далее соединяем &bПар воды&r с &6Триоксидом серы&r, чтобы получить &2Серную кислоту&r."
]
quest.31EEE2875595F315.quest_subtitle: "Краткое напоминание"
quest.31EEE2875595F315.title: "&2Серная кислота"
quest.32E093F004E8CAC6.title: "&dУльтимативные универсальные кабели"
quest.331934749C1DE9A0.quest_desc: ["Механический компонент, используемый для смешивания и обработки материалов. Необходим в крафтовых установках, где ингредиенты нужно перемешивать или мешать с помощью вращательной энергии."]
quest.338E4A4F41889959.quest_desc: [
	"ME Crafting Terminal — это улучшенная версия ME Terminal, которая имеет встроенную сетку крафта с доступом к Networked Storage сети ME."
	""
	"Как и ME Terminal, он также требует наличия Канала для работы."
]

quest.338E4A4F41889959.quest_desc: [
	"ME Crafting Terminal — это улучшенная версия ME Terminal, которая имеет встроенную сетку крафта с доступом к Networked Storage сети ME."
	""
	"Как и ME Terminal, он также требует наличия Канала для работы."
]
quest.33FE53F9B5BA0001.quest_desc: ["Метательная граната с медным корпусом, предназначенная для нанесения урона в области взрыва. Металлический корпус делает её прочной и немного тяжёлой, идеально подходит для зачистки групп врагов или пробивания препятствий."]
quest.3424B27C62D3D2CF.quest_desc: [
	"Обеспечивает беспроводной доступ через Wire Terminal. Дальность и потребление энергии зависят от количества установленных Wire Booster."
	""
	"Сеть может иметь любое количество точек беспроводного доступа с любым числом Wire Booster в каждой, позволяя оптимизировать использование энергии и дальность, изменяя конфигурацию."
	""
	"Требуется канал."
	""
	"Также используется для привязки беспроводных терминалов."
]
quest.35296382603A6E78.quest_desc: ["Лёгкий метательный взрывчатый с цинковым корпусом, обеспечивающий портативность и быструю развертку. Лёгкая оболочка уменьшает силу взрыва по сравнению с тяжёлыми металлическими гранатами, но её проще носить и метать многократно — удобно для быстрых схваток или зачистки небольших групп врагов."]
quest.35365535ED46DAD0.quest_desc: ["Applied Energistics 2 (AE2) — комплексный мод для Minecraft, который вводит уникальный подход к управлению инвентарём. Основная идея заключается в конверсии материи в энергию и обратно, чтобы мгновенно хранить и перемещать ваши предметы и жидкости!"]
quest.35365535ED46DAD0.title: "Добро пожаловать в &eApplied Energistics 2"
quest.3562111D841CF498.quest_desc: [
	"Sequenced Gearshift позволяет точнее контролировать вращательную силу, делая несколько изменений вращения за определённый промежуток времени."
	""
	"Gearshift может принимать до 5 команд одновременно. Каждую команду можно настроить, наведя на неё курсор и прокручивая в интерфейсе."
	""
	"Первая колонка состоит из команд: Повернуть на угол, Повернуть Поршнем, Задержка, Ожидание нового сигнала редстоуна, Конец. Первые две команды — просто разные измерения вращения для Механических поршней и подшипников. Третья команда заставляет Gearshift ждать перед выполнением следующей команды, четвёртая останавливает последовательность до получения нового импульса. Конец обозначает завершение последовательности, но необязателен для её выполнения."
	""
	"{@pagebreak}"
	""
	"Вторая колонка настраивает измерения для каждой команды: до 360 градусов для Поворота, 128 блоков для Поршня и 30 секунд для Ожидания."
	""
	"Третья колонка регулирует скорость и направление: вращение может быть удвоено, обращено, одновременно или не изменено."
	""
	"С помощью компаратора редстоуна можно определить, какая команда выполняется Gearshift. Он выдаёт сигнал силой до 5, независимо от количества команд в устройстве."
]
quest.35639D4A6DDF6FF9.quest_desc: [
	"Муфта останавливает исходное вращение при подаче сигнала редстоуна."
	""
	"Когда муфта не активна, она передаёт вращение как вал. При активации передача вращения прекращается."
]
quest.357E50BEAF1E8F74.quest_desc: ["Специальная книга, которая хранит информацию о найденных рудных жилах. Позволяет отслеживать и находить ценные ресурсы, делая добычу и раскопки более эффективными и организованными."]
quest.3591EAA8E397F992.quest_desc: [
	"Давайте ещё раз пройдёмся по чек-листу &b&o, чтобы убедиться, что всё готово к запуску:"
	""
	"1. &6Защитный костюм&r включён (безопасность прежде всего!)"
	"2. &9Вода/охлаждающая жидкость&r подаётся в входной Порт."
	"3. &3Делящаяся топливо&r подаётся в входной Порт."
	"4. Порт настроен на вывод нагретого охлаждающего вещества, либо в мусорный бак, либо в &2Промышленную турбину&r."
	"5. Порт настроен на вывод &0Ядерных отходов&r к &eБочкам радиоактивных отходов&r или машинам для переработки, либо и то, и другое!"
	""
	"Если всё готово, нажимайте кнопку &eActivate&r!"
	""
	"Вы также можете настроить &3Скорость сгорания&r для увеличения производства &0Ядерных отходов&r, но начинайте медленно."
]
quest.3591EAA8E397F992.title: "Запуск реактора"
quest.35C37231C1C86294.quest_desc: [
	"Суперклей имеет два режима использования: Режим по блоку и Режим области. Их можно комбинировать в одном механизме."
	""
	"Каждое использование уменьшает прочность на один. (Прочность означает количество применений тюбика клея. Клей, скрепляющий блоки, остаётся до снятия.) Суперклей можно зачаровать на Неразрушимость и Починку для продления срока службы."
	""
	"{@pagebreak}"
	""
	"Режим по блоку"
	"В режиме по блоку суперклей используется как слизистый шарик. Правый клик по Linear или Radial Chassis с суперклеем покрывает грань шасси зелёным клеем для прикрепления других блоков."
	""
	"Суперклей можно держать в левой руке при установке блоков для автоматической проклейки каждого блока. Края шасси нельзя покрыть клеем, как грань. Однако при удержании суперклея в левой руке блоки всё ещё можно прикреплять к краям шасси."
	""
	"Удалять клеевые покрытия граней шасси можно правым кликом пустой рукой при приседании."
	""
	"{@pagebreak}"
	""
	"Режим области"
	"Режим области используется для склеивания группы блоков после их установки. Клик по углу области с суперклеем выделяет первый блок, переместите курсор к противоположному углу. Появится зелёная рамка, показывающая склеиваемые блоки. Клик снова завершает процесс. Для отмены клик при приседании."
	""
	"Второй блок может находиться до 24 блоков от первого, а максимальный объём выделения — 2312 блоков. Независимо от размера, расходуется только 1 прочность. Перекрывающиеся клеевые области объединяются, сохраняя форму. Нельзя выделять грань шасси в режиме области, вместо этого используется режим по блоку. Чтобы выбрать шасси, кликайте по стороне, а не по грани."
	""
	"Склеенные области видны, если держать суперклей в основной руке. Склеенные блоки выделяются зелёной рамкой. Блоки, склеенные по режиму по блоку, не показываются зелёной рамкой. Блоки, прикреплённые с суперклеем в левой руке, будут выделены зелёной рамкой."
]
quest.35C37231C1C86294.title: "&aСуперклей"
quest.35F24F6E403AADA1.quest_desc: ["Редуктор с валами на всех 6 сторонах. Внутренний механизм аналогичен Parallel Gearbox, поэтому верх и низ вращаются на половинной скорости."]
quest.3617DE87C4E1BCB9.quest_desc: ["Ручная рукоятка генерирует небольшое количество вращательной силы через взаимодействие игрока."]
quest.3658B862EEE320BD.quest_desc: ["&dСупермассивный QIO Drive&r может содержать &o&b16,000,000,000&r &nпредметов&r и &o&b8,192&r &nтипов предметов&r."]
quest.3663E93E169EF8E3.quest_desc: ["С помощью другого &9Chemical Infuser&r мы хотим соединить &bФтористоводородную кислоту&r с &eОксидом урана&r для получения &2Гексафторида урана&r."]
quest.3663E93E169EF8E3.title: "&2Гексафторид урана"
quest.36766831FDA775FD.quest_desc: ["Изготовлено в нагретом бассейне с прессом."]
quest.36B1995B495AA674.quest_desc: [
	"Чтобы начать изучение реакторов Mekanism, сначала создадим &aРеактор деления&r. Это мультблоковые конструкции, генерирующие большое количество тепла за счёт сжигания &3Делящегося топлива&r. Реактор сам по себе не производит энергию, но выделяемое тепло можно использовать для нагрева &bОхлаждающей жидкости&r, применяемой для генерации энергии в &aПромышленной турбине&r."
	""
	"&aРеактор деления&r может быть очень опасен: при аварии возможен &cвзрыв&r и &2радиация&r на &o&bрадиус 5 чанков&r, сохраняющаяся несколько &nигровых недель&r."
	""
	"Но мы подготовимся. Сначала создадим &6Защитный костюм&r на всякий случай."
]
quest.36B1995B495AA674.title: "Защитный костюм"
quest.3734081CB77CDBB5.quest_desc: [
	"Материальные шары в Matter Cannon можно заменить на красящие шары, которые создают эффект разбрызгивания краски на блоке."
	""
	"Lumen Paint Balls — вариант красящих шаров исключительно для Matter Cannon, краска которых светится после появления в мире."
]
quest.3734081CB77CDBB5.title: "Материальные / красящие / светящиеся шары"
quest.383D6F1A001A0AEC.quest_desc: [
	"Жёлоба перемещают предметы вертикально, обычно вниз, если только не используется Encased Fan для поддува предметов вверх. Существуют два типа: обычный Жёлоб и Умный Жёлоб. Умные Жёлоба позволяют игроку контролировать типы передаваемых предметов и размер стека."
]
quest.387FC4D9C4010FD8.quest_desc: ["Автоматизированный Верстак Инженера — это мультблок 3x2x3. Он является автоматизированной версией обычного Верстака Инженера."]
quest.387FC4D9C4010FD8.title: "Автоматизированный Верстак Инженера"
quest.38E84EA139A2316C.quest_desc: [
	"Drive — это устройство, в которое вставляются ваши ячейки хранения для использования их в сетевом хранилище. Имеет 10 слотов, каждый из которых принимает одну ячейку."
	""
	"Если нужно, ячейки можно вставлять и извлекать с его инвентаря любыми средствами логистики, например, воронками или шинами AE2."
	""
	"Может быть повернут с помощью Certus Quartz Wrench."
]
quest.38E9C4DB82B1279A.quest_desc: [
	"Когда блок неподвижен, на его фильтр можно применить определённые предметы. Если установлен фильтр, он будет влиять только на этого актёра механизма. Если подать сигнал редстоуна до и во время сборки, актёры механизма будут изначально отключены. Учтите, что редстоун и рычаги на собранных Contraptions не действуют."
	""
	"На собранном Contraption можно кликнуть по Contraption Controls, чтобы включать и отключать определённые Contraption Actors."
]
quest.39124F73B82400F4.quest_desc: ["Преобразует вращательную энергию машин Create в FE с эффективностью около 75%."]
quest.3931273289B3A68C.quest_desc: [
	"Fluix ME Glass Cable — самый простой кабель для создания, передаёт энергию и до 8 каналов. Выпускается в 17 цветах, стандартный — Fluix, но может быть окрашен любым из 16 красителей."
	""
	"Для создания цветного кабеля оберните краситель 8 кабелями того же типа (цвет кабелей не важен, но они должны быть одного типа: стекло, умный и т.д.). Можно также покрасить кабель кистью, совместимой с Forge."
	""
	"Для очистки кабеля от красителя можно использовать ведро с водой."
	""
	"Кабель можно покрыть шерстью для создания Fluix ME Covered Cable, а Fluix ME Smart Cable поможет лучше понять, что происходит с каналами."
]
quest.3999760881C855FA.quest_desc: [
	"Chemical Crystallizer превращает Clean Slurry в кристаллы, Lithium в Lithium Dust и Antimatter в Antimatter Pellet. Это одна из немногих машин Mekanism с фиксированными сторонами для ввода и вывода (кроме настройки сторон для предметов)."
	""
	"Ввод — газ (использует Pressurized Tube), вывод — предметы (использует Logistical Transporter)."
]
quest.3999760881C855FA.quest_subtitle: "Превращает рудную суспензию в кристаллы"
quest.39AC44DD78BB695F.quest_desc: ["Базовый, но надёжный источник энергии для генерации сильной вращательной силы. Надёжен и прост в обслуживании, подходит для средних и крупных механических систем."]
quest.39C8CD6102B26BFE.quest_desc: ["Широко используется для создания предметов, описанных в Инженерных чертежах. Большое количество чертежей можно скрафтить, как указано в соответствующем руководстве, а некоторые — только обнаружить в мире или купить у жителей."]
quest.3A059BC37D957B99.quest_desc: ["Основная механическая деталь для передачи вращательной силы между соединёнными машинами. Необходима для подключения двигателей, редукторов и других движущихся компонентов в автоматизированных системах."]
quest.3A2633B6030BBC52.quest_desc: ["Когда надеты, Инженерские очки показывают нагрузку на просматриваемую машину во время её работы. Также отображают числа и выделяют текущую скорость вращения при просмотре Stressometer или Speedometer. Дополнительно показывают количество жидкости в баке и общую ёмкость бака."]
quest.3AB541A2323AF3B3.quest_desc: [
	"&6QIO&r — это способ хранения больших количеств предметов, с возможностью поиска и удалённого доступа на поздних этапах игры."
	""
	"Состоит как минимум из одного &aQIO Drive&r (для хранения предметов), &9QIO Drive Array&r (для размещения &aQIO Drives&r) и как минимум одного &3QIO Dashboard&r (для доступа к предметам в &2QIO Drive Array&r)."
	""
	"Для работы накопители и массив должны быть настроены на &o&bодну и ту же частоту&r."
	"{image:kubejs:textures/item/qio_setup.png width:300 height:120 align:1}"
]
quest.3AD4622409437713.quest_desc: [
	"Экскаватор состоит из двух частей:"
	"Bucket Wheel — центральная часть, формируется правым кликом Engineers Hammer по среднему стальному блоку."
	"Двигатель — другая часть, формируется правым кликом Engineers Hammer по Heavy Engineering Block в центре задней стороны."
	""
	"Ввод энергии для двигателя находится сбоку, сзади расположен панель управления редстоуном и вывод предметов."
]
quest.3AD4622409437713.title: "Экскаватор"
quest.3AE2172B95B58B99.quest_desc: [
	"&aQIO Drives&r вставляются в &9Drive Array&r, позволяя хранить больше предметов."
	""
	"Каждый накопитель имеет ограничение на количество предметов и типов предметов. &aBasic QIO Drive&r может содержать &o&b16,000&r &nпредметов&r и &o&b128&r &nтипов предметов&r."
]
quest.3AF4E5D4839CEF8B.quest_desc: ["Как только мы получим &eYellow Cake Uranium&r, мы можем отправить его через &aChemical Oxidizer&r для получения газа &2Uranium Oxide&r."]
quest.3AF4E5D4839CEF8B.title: "&eОксид урана"
quest.3B3C89649DF57161.quest_desc: [
	"Quantum Network Bridges могут расширять сеть на бесконечные расстояния и между измерениями. Они могут передавать 32 канала в целом, действуя как беспроводной плотный кабель."
	""
	"Восемь таких квантовых колец, расположенные вокруг ME Quantum Link Chamber, создают Quantum Network Bridge. Только 4 блока ME Quantum Ring, примыкающие к ME Quantum Link Chamber, принимают сетевые подключения, 4 угловых блока не могут подключаться к кабелям."
]
quest.3B3C89649DF57161.title: "&6Квантовый мост"
quest.3B43DB1A6B0A7B44.quest_desc: ["Bio Fuel добавляется Mekanism и используется как топливо для Bio-Generator. Также Bio Fuel применяется в Pressurized Reaction Chamber для получения Ethylene."]
quest.3B43DB1A6B0A7B44.title: "Bio Fuel"
quest.3B73F2EBCCD1884C.quest_desc: ["Автоматически пополняет гаджеты и броню, использующую воду."]
quest.3B81800EE6E77EF2.quest_desc: [
	"&6Реактор деления&r требует &3Делящегося топлива&r для работы. Если сейчас открыть &3Fissile Fuel&r в &bJEI&r, можно растеряться от всех компонентов. Не волнуйтесь, мы разберёмся шаг за шагом."
	""
	"Всё сводится к созданию &eГексафторида урана&r. Для этого нужно сделать два газа: &bHydrofluoric Acid&r и &eUranium Oxide&r."
]
quest.3C49F2EEDCCAF1DF.quest_desc: [
	"Базовая схема фабрики должна быть такой:"
	""
	"Сырая руда → Chemical Dissolution Chamber → GAS → Chemical Washer → GAS → Chemical Crystallizer → кристаллы → Chemical Injection Chamber → осколки → Purification Chamber → комки → Crusher → грязная пыль → Enrichment Chamber → чистая пыль → Smelter."
]
quest.3C49F2EEDCCAF1DF.title: "Ore Factory: Tier 4"
quest.3CA5DFF1105281D6.quest_desc: [
	"Это мультблок-батарея."
	"Можно подавать и получать FE через маленький коннектор."
]
quest.3CA5DFF1105281D6.quest_subtitle: "Большая батарея"
quest.3E1695A1D5FA81AD.quest_desc: ["Сигнальное устройство, управляющее движением с помощью красного, жёлтого и зелёного света. Идеально для автоматизированных транспортных систем и добавления реализма в городские и дорожные постройки."]
quest.3F249BE37B1BB214.quest_desc: [
	"Этот мод добавляет скрытые бесконечные жилы руды в мир. Их можно добывать с помощью машин. Требуется мод Create."
	""
	"Особенности:"
	""
	"Добавляет скрытые жилы руды и водные резервуары, которые с вероятностью могут появиться в чанке. В каждом чанке может быть только одна жила."
	""
	"Жилы бесконечны."
	""
	"Добывайте руду с помощью Drilling Machine и Fluid Extractor."
	""
	"Машины работают на вращательной силе."
	""
	"Используйте предмет 'Ore Vein Finder', чтобы находить жилы руды и водные резервуары."
]
quest.3F5010269469EBE0.quest_desc: [
	"Внутренняя часть реактора построена из колонн из блоков &9Fission Fuel Assembly&r, с одним &eControl Rod Assembly&r на вершине каждой колонны. Высота колонн от &b&o1&r до &b&o15&r блоков в зависимости от размера реактора."
	""
	"Для этой сборки поместим &b&o2&r блока &9Fission Fuel Assemblies&r в &nцентр&r мультблока и сверху &eControl Rod Assembly&r."
]
quest.3F5010269469EBE0.title: "Контроль топлива"
quest.3F925BFD3CF1DC0B.quest_subtitle: "Используется для увеличения дальности точки беспроводного доступа."
quest.3FFF9018DA2A2763.quest_desc: [
	"После начала сжигания &3Делящегося топлива&r в &6Реакторе&r мы получим нагретую &bОхлаждающую жидкость&r и &8Ядерные отходы&r."
	""
	"Здесь начинается воздействие &4Радиации&r. Пока она &b&oнаходится безопасно в контейнере или машине&r, никаких утечек не будет... верно?"
	""
	"Лучший способ хранения &4радиоактивного&r вещества — &2Бочка радиоактивных отходов&r. Они безопасно хранят отходы, постепенно разрушая газ без утечки &4Радиации&r. Не оставляйте &8Ядерные отходы&r в &6Реакторе&r — это увеличивает нагрев. Настройте порт на вывод &8Отходов&r и отправьте их в бочку!"
	""
	"&cВажно&r: Разрушение &nлюбого&r блока, машины, бочки, трубы или &nлюбого&r предмета с &4Радиоактивным&r газом вызовет утечку радиации&r. Это касается и продуктов &8Ядерных отходов&r, таких как &5Полоний&r или &eПлутоний&r."
]
quest.3FFF9018DA2A2763.title: "&8Ядерные отходы"
quest.405A318D640D514E.quest_desc: [
	"Blast Stove может принимать газ из печи, поэтому ваша печь может быть самодостаточной без лишнего угля для получения креозота."
	""
	"Установите люк сверху отверстия печи для сбора газа."
]
quest.407FBBE12EA9ED9B.quest_desc: ["Высокопроизводительный компонент двигателя, рассчитанный на высокое давление от сгорания дизеля. Обеспечивает мощный и эффективный выход энергии, идеально подходит для тяжёлой техники и сложных автоматизированных систем."]
quest.40BEBD299B406E1A.quest_desc: ["Универсальная машина, преобразующая вращательную или кинетическую энергию в электричество. Необходима для эффективного питания электрических систем, машин и автоматизированных установок."]
quest.40F8FF1E85694FD4.quest_desc: ["Получено путём обработки медного листа в Прокатном стане."]
quest.40F8FF1E85694FD4.quest_subtitle: "Компонент для крафта"
quest.4181323BF72047A9.quest_desc: [
	"Кликните правой кнопкой по действующему кондуктору с расписанием, чтобы назначить ему задание. Кондуктор должен быть либо мобом, сидящим прямо перед Train Controls на собранном поезде, либо Blaze Burner, расположенным аналогично."
	""
	"Можно добавить 3 типа команд:"
	""
	"Travel to Station — перемещение к указанной станции."
	"Update Schedule Title&r — название маршрута, отображаемое в Train Station summary в Display Link."
	"Limit Max Speed — изменение максимальной скорости при движении к станции."
]
quest.419BBE875D40B1D6.quest_desc: [
	"ME Export Bus извлекает предметы из сетевого хранилища ME Network и помещает их в инвентарь, на который он направлен."
	""
	"Необходимо настроить, какие предметы будут вставляться; если оставить конфигурацию пустой, ничего не произойдёт."
	""
	"ME Export Bus попытается экспортировать все предметы из своего списка, пропуская те, которые не помещаются в целевой инвентарь."
	""
	"Для работы &rME Export Bus&r требуется канал."
	""
	"Это функциональная противоположность ME Import Bus."
]
quest.41A3DDA294728106.quest_desc: [
	"Create Stuff 'N Additions — мод, использующий ресурсы Create, чтобы предложить новый набор оборудования, инструментов и гаджетов!"
	""
	"Оборудование увеличивает ваши физические возможности (силу или скорость добычи), а также даёт новые способы передвижения: плавание, отскок и даже полёт! В зависимости от типа оборудования (латунь, андезит или медь) потребуется разное топливо: пар (вода + топливо), тепловая энергия (только топливо) или гидравлическая энергия (вода)!"
	""
	"Мод также добавляет множество рецептов, позволяющих создавать стандартные предметы Minecraft (кольчужная броня, кораллы, Нетеррак, плачущий обсидиан, кремний лавы и др.) с использованием новых механик Create, таких как 'haunting' и 'filling'."
]
quest.41EB0C570FC54F43.quest_desc: [
	"&aChemical Tanks&r используются для хранения &7газов&r."
	""
	"Могут быть размещены как блоки и взаимодействовать с &dPressurized Tubes&r."
	""
	"Существуют четыре уровня, каждый последующий имеет вдвое большую ёмкость и скорость вывода по сравнению с предыдущим."
]
quest.4204702AA6FBF40B.quest_desc: [
	"Chargepad — беспроводная зарядная станция. Любые перезаряжаемые предметы в инвентаре будут заряжаться, пока вы стоите на ней."
	""
	"Chargepad может перезаряжать любые предметы, требующие энергии. Также он служит точкой размещения и телепортации вашего Robit."
]
quest.42195C45933ACA1E.quest_desc: ["Добро пожаловать в Create: Central Kitchen — мод, предоставляющий новые инструменты и способы автоматизации обработки пищи для других модов Create."]
quest.421EA2CE61003DA1.quest_desc: ["Позволяет игроку летать, быстрее передвигаться и плавать. Работает с топливом."]
quest.4236B9F071BE18F3.quest_desc: [
	"Rotary Condensentrator (произносится как \"кон-ДЕН-сен-трейтр\") используется для конверсии веществ между жидкой и газообразной формой в соотношении 1:1. Имеет два режима: Decondensentrating (жидкость → газ) и Condensentrating (газ → жидкость)."
	""
	"В режиме Decondensentrating:"
	"Liquid → Gas"
	"Water → Water Vapor"
	"Liquid Sulfuric Acid → Sulfuric Acid"
	"Liquid Hydrogen Chloride → Hydrogen Chloride"
	"Liquid Oxygen → Oxygen"
	"Liquid Hydrogen → Hydrogen"
	"Liquid Ethylene → Ethylene"
	"Liquid Chlorine → Chlorine"
	"Liquid Sulfur Dioxide → Sulfur Dioxide"
	"Liquid Sulfur Trioxide → Sulfur Trioxide"
	"Brine → Gaseous Brine"
	"Liquid Lithium → Lithium"
	"В режиме Condensentrating — наоборот."
	""
	"Извлекайте жидкости с помощью Mechanical Pipe, установив режим «pull» (используйте Configurator + Shift+Правый клик по внешним краям трубы)."
]
quest.4266BF7FCE3B4330.quest_desc: [
	"Cogwheel — базовый механический компонент в Create для передачи вращения."
	"Large Cogwheel — крупная версия Cogwheel, которая передаёт вращение через углы и может приводить в действие Rotation Speed Controllers."
]
quest.4266BF7FCE3B4330.title: "Зубчатые колёса"
quest.4276B941670CE0E2.quest_desc: [
	"P2P туннели позволяют передавать предметы, жидкости, редстоун-сигналы, энергию, свет и каналы по сети без их прямого взаимодействия с сетью. Существует множество вариантов P2P туннелей, каждый транспортирует только определённый тип."
	""
	"По сути, это порталы, напрямую соединяющие две поверхности блоков на расстоянии. Они не двунаправленные — есть чётко определённые входы и выходы."
	""
	"{@pagebreak}"
	""
	"Существует много типов P2P туннелей. Только ME P2P Tunnel создаётся напрямую; остальные получаются кликом по другим туннелям с определёнными предметами:"
	""
	"ME P2P Tunnel — правый клик любым кабелем."
	"Redstone P2P Tunnel — правый клик с различными компонентами редстоуна."
	"Item P2P Tunnel — правый клик с сундуком или воронкой."
	"Fluid P2P Tunnel — правый клик с ведром или бутылкой."
	"Energy P2P Tunnel — правый клик почти любым энергетическим предметом."
	"Light P2P Tunnel — правый клик с факелом или светокамнем."
	"Некоторые типы туннелей имеют особенности. Например, каналы ME P2P Tunnel не могут проходить через другие ME P2P Tunnel; Energy P2P Tunnel косвенно изымает 2,5% FE, проходящего через него, увеличивая собственное потребление."
	""
	"{@pagebreak}"
	""
	"Наиболее распространённое применение P2P туннелей — использование ME P2P Tunnel для уплотнения каналов. Вместо множества плотных кабелей можно использовать один, чтобы передавать сразу несколько каналов."
]
quest.4291A72FF87220D5.quest_desc: [
	"Существует также инвертированная версия toggle bus, которая &nотключает&r соединение при подаче &cредстоун&r сигнала."
	""
	"Когда подаётся &cредстоун&r сигнал, стандартная часть &nвключает&r соединение, а &6ME Inverted Toggle Bus&r обеспечивает &nобратное&r поведение, &nотключая&r соединение."
]
quest.43D31DAC4737005E.quest_subtitle: "Побочный продукт коксовой печи"
quest.43E02E5DBDE6F0D2.quest_desc: ["Промышленная структура для безопасного сжигания избыточных газов и побочных продуктов. Помогает управлять отходами на больших фабриках, обеспечивая более чистое и эффективное производство."]
quest.43E4EE94BB396A7C.quest_desc: ["Используется для изготовления стержней и проводов."]
quest.43FBFDBCDB69E7EE.quest_desc: [
	"&ePortable Teleporter&r — портативное телепортационное устройство для игрока."
	""
	"Может хранить энергию, и как все телепортеры &dMekanism&r, потребление энергии увеличивается с расстоянием телепортации. &aПравый клик&r этим устройством откроет &o&bGUI&r&b, похожий на &9Teleporter Portal&r, позволяющий мгновенно перемещаться к любым &3Teleporter Portals&r, которые установил игрок. &ePortable Teleporter&r поддерживает перемещение между измерениями."
	""
	"Для работы &ePortable Teleporter&r полная структура &9Teleporter Portal&r не обязательна; нужен только &o&bTeleporter блок&r (и он должен быть &nподключен к энергии&r)."
]
quest.4434D7B66521D69A.quest_desc: ["Pressurized Tubes используются для транспортировки газов."]
quest.4434D7B66521D69A.title: "&aБазовая прессуризированная труба"
quest.445ACC0E40DB3D96.quest_desc: ["Частично собранный электрический компонент, ожидающий окончательной обработки. Используется для крафта полных резисторов и других сложных электронных деталей."]
quest.449C41A3AFBBE8E9.quest_desc: ["Использует железо и кокс для производства стальных слитков и шлака. В отличие от улучшенной доменной печи, шлак может не удаляться, что ограничивает автоматизацию."]
quest.449C41A3AFBBE8E9.title: "Грубая доменная печь"
quest.44E8D5277063565A.quest_desc: ["Мониторинг устройства, измеряющего и отображающего напряжение в электрической цепи. Полезно для диагностики колебаний мощности и обеспечения оптимальной работы систем."]
quest.4512B97451C2221F.quest_desc: ["Mechanical Arm может брать или класть предметы с различных блоков в радиусе 5 блоков. Выбранные блоки можно просмотреть, наведя на Mechanical Arm с Wrench. Передача возможна до полного стека предметов за один раз."]
quest.459AA2AD67CA6AAA.quest_desc: ["Смешайте алюминий и crimsite."]
quest.45BA5B8A785E1B82.quest_desc: [
	"Использование Wrench на компоненте поворачивает его вокруг той грани, с которой вы взаимодействовали."
	""
	"Использование Wrench на компоненте, редстоун-компоненте, рельсе или его ванильной версии разберёт его и поместит в инвентарь. Любой блок, который можно вращать или взаимодействовать правым кликом, должен быть разобран при зажатом Shift."
	""
	"Наведение на некоторые настраиваемые компоненты позволяет конфигурировать их с помощью прокрутки."
	""
	"Для определённых компонентов, таких как Linear Chassis, можно удерживать ctrl, чтобы настроить все подключённые компоненты одновременно."
]
quest.45CEF843FA33853F.quest_desc: ["Вы можете захватывать блоки, перемещать их и запускать в воздух!"]
quest.46004D01A142777E.quest_desc: ["Smart Fluid Pipes позволяют пропускать только определённую жидкость."]
quest.46AB23E922C51517.title: "&9Элитный логистический транспортер"
quest.46EBE6B0E06D750D.quest_desc: ["Используется с &6Spatial IO Port&r для хранения пространственных регионов."]
quest.470B1F84D01E4F7A.quest_desc: ["Заряженный кристалл Certus Quartz создаётся путем вставки Certus Quartz Crystal в Зарядное устройство и подачи энергии."]
quest.47106CE1937C4340.quest_desc: ["Чтобы получить HDPE Sheet, поместите 3 HDPE Pellets в Enrichment Chamber."]
quest.47ACCCE2F34C5B99.quest_desc: [
	"Для использования предметы сбрасываются в верхнюю часть структуры, а вынимаются через чёрный порт внизу. У машины нет GUI — вращаются дробильные колёса во время работы. Можно также дробить мобов, получая соответствующие дропы. Если Crusher получает предмет, который не может обработать, он будет уничтожен."
	""
	"Энергия подаётся через медную точку, а машину можно выключить, подавая сигнал редстоуна на красную точку спереди."
]
quest.47ACCCE2F34C5B99.title: "Дробилка"
quest.488DBE69595F38F8.quest_desc: ["Energized Smelter — базовая электрическая печь, использующая энергию вместо топлива для плавки предметов."]
quest.4905CD63121F13EA.quest_desc: ["Автоматически пополняет устройства и броню, использующие топливо."]
quest.49E36D3C3092346E.quest_desc: [
	"IO Port позволяет быстро заполнять или опустошать ячейки хранения в сетевое хранилище или из него."
	""
	"Может быть повернут с помощью Certus Quartz Wrench."
	""
	"IO Port можно настроить на перемещение ячейки в выходные слоты, когда она пуста, полна или когда работа завершена."
	"Если вставлена Redstone Card, будут доступны различные условия работы через редстоун."
	"В центре GUI есть стрелка для выбора направления передачи предметов: из ячейки в сеть или из сети в ячейку."
	""
	"Улучшения"
	"IO Port поддерживает следующие улучшения:"
	""
	"Acceleration Card — увеличивает количество предметов, перемещаемых за одну операцию"
	"Redstone Card — добавляет управление редстоуном: активен при высоком сигнале, низком или один раз за импульс"
]
quest.4A19E3387DBD7FB0.quest_desc: [
	"Winder использует катушки провода, чтобы наматывать их на предметы."
	""
	"Рецепты, использующие Winder (например, генераторы или потенциометры), всегда используют точное количество провода."
	""
	"Для намотки магнитных катушек можно установить процент намотки из 1000 оборотов, минимум 100 оборотов (10% = 100 оборотов). Обороты сверх 100 используются только для трансформаторных катушек. Остаток на катушке можно проверить с помощью Goggles."
	""
	"Предметы нельзя извлекать вручную (кроме катушки провода), фильтра для незавершённых предметов нет. Для ручной намотки используйте Funnel и Lever."
]
quest.4A22534045841AE4.quest_desc: ["Низкий ток"]
quest.4A47E558AD90EB64.quest_desc: ["Обеспечивает интерфейс для одновременного доступа к двум инвентарям. Имеет слоты фильтров для быстрой сортировки входящих предметов."]
quest.4A7F96E62A5845C5.quest_desc: [
	"Mechanical Pistons — это Contraption, который сталкивается с неподвижными блоками."
	""
	"Для выдвижения поршень должен иметь Piston Extension Poles на конце и получать вращательную энергию. Максимальная длина полюса — 64 блока, это можно изменить в конфиге."
	""
	"При реверсе вращения поршень втягивается. Конец должен быть сделан липким с помощью Slimeball, чтобы возвращать зажатые блоки."
]
quest.4A859875AFC89A13.quest_desc: ["Ключевой механический компонент, который сжимает и направляет энергию внутри двигателя. Необходим для превращения топлива или давления в плавное, стабильное вращательное движение."]
quest.4A961ADDC8054AA1.quest_desc: ["Магнитное устройство, притягивающее к себе предметы с помощью вращательной энергии. Идеально для автоматизации, где сбор предметов должен быть быстрым и эффективным."]
quest.4AFF81D3D0E78255.quest_desc: [
	"Chemical Washer превращает Slurry в Clean Slurry с помощью воды. Чистая суспензия затем должна быть дополнительно очищена в Chemical Crystallizer. В отличие от большинства машин Mekanism, у этой фиксированные стороны «вход» и «выход» для минералов. «Вход» слева при первой установке, «выход» справа. Можно повернуть с помощью Configurator. Вода подается сверху."
]
quest.4AFF81D3D0E78255.quest_subtitle: "Окунуть руды в ванну"
quest.4B976C143EDA4317.quest_desc: [
	"Casings — это блоки, используемые во многих рецептах Create, а также для декора и эстетики."
	""
	"Существует четыре типа Casings: Andesite Casings в основном используются в базовых Contraptions."
	""
	"{@pagebreak}"
	"Casings создаются только физическим применением допустимого сплава или слитка к любой Stripped версии дерева или бревна. Бревно превращается в casing."
	""
	"Mechanical Belts, Shafts и Cogwheels можно помещать в большинство casing, создавая декоративную оболочку вокруг блока. Медные casing можно использовать только для Fluid Pipes. Точно так же труба не примет другой тип casing."
]
quest.4B976C143EDA4317.title: "Андезитовый корпус"
quest.4BB13C80196FD034.quest_desc: [
	"Мод Create приносит настоящую инженерию в Minecraft!"
	"Вместо простых машин вы используете вращательную энергию от водяных колёс, ветряков и других механизмов."
	""
	"С помощью Create можно автоматизировать фермы, строить фабрики или проектировать движущиеся машины, которые работают плавно и красиво."
]
quest.4BB13C80196FD034.quest_subtitle: "Create"
quest.4BB13C80196FD034.title: "Create"
quest.4BDE773C3359D584.quest_desc: [
	"Robit — механический спутник Mekanism. Может быть сеткой крафта, печью, наковальней, сундуком или просто милым другом. Неуязвим к огню, включая огнемёт."
	""
	"{@pagebreak}"
	"Чтобы вызвать личного робота, нужно скрафтить его. После появления в инвентаре, кликните правой кнопкой по Chargepad с ним в руке. Robit появится и привяжется к Chargepad. Убедитесь, что Chargepad имеет питание, иначе он не сможет следовать за вами!"
	""
	"Если нужно забрать Robit, Shift + правый клик с Configurator."
	""
	"Не переживайте о его потере: когда заряд или здоровье заканчиваются, он автоматически телепортируется на зарядную станцию. У него нет обычного здоровья: повреждения уменьшают заряд. Полностью заряженный Robit имеет эквивалент здоровья 100 или 50 сердец."
	""
	"При разрушении Chargepad, Robit превращается в предмет для подбора. Он сохраняет свои предметы, но может исчезнуть, если его не подобрать."
]
quest.4C7CD3858A2BE870.quest_desc: [
	"Mechanical Press — механический компонент, который применяет рецепты Pressing, Packing и Compacting к предметам под ним. Используется для прессования слитков в Sheets, необходимые для компонентов высокого уровня."
	""
	"Mechanical Press питается через внутренний Shaft с двух противоположных сторон. Как и Shafts, Presses передают вращение вдоль оси. Обрабатывает предметы быстрее при более высокой скорости вращения."
]
quest.4CDB3F8E217ADC8E.quest_desc: ["Специализированный металлический слиток с магнитными свойствами. Используется для крафта сложных машин, моторов и компонентов, основанных на магнитной энергии или притяжении."]
quest.4CE350628327599A.quest_desc: [
	"&eME Level Emitter&r может показывать уровень заданного предмета или уровень энергии &dME Network&r."
	""
	"Можно настроить порог и указать, будет ли &eME Level Emitter&r выдавать сигнал редстоуна или выключаться."
	""
	"Не требует &eChannel&r; при потере питания эмиттер переходит в выключенное состояние."
	""
	"Можно подключать к &bcrafting system&r при установке crafting card, чтобы выдавать сигнал редстоуна во время крафта или настраивать его для автоматического выполнения задач крафта. Важно: нельзя смешивать сигналы уровня через &credstone&r с &binterface patterns&r."
]
quest.4CEF6501FCD7D58D.quest_desc: ["Базовый, но функциональный компонент двигателя, который помогает превращать давление или сгорание в движение. Идеален для ранней стадии машин и низкомощных механических систем."]
quest.4CFE8B1C53B429E9.quest_desc: ["Crafter Slot Covers используются для обозначения пустых слотов в установках Mechanical Crafter."]
quest.4D482A1A908ABFDA.quest_desc: [
	"В отличие от Linear Chassis, Radial Chassis подключается к радиусу блоков вокруг себя, а не к прямой линии. Это может быть неудобно, если рядом есть блоки, к которым не хочется подключаться."
	""
	"Можно кликнуть по сторонам шасси с Slimeball или Super Glue, чтобы сделать их липкими, и снова, чтобы применить ко всем сторонам. Предметы не расходуются. Радиус влияния блоков можно изменить для каждого шасси с помощью Wrench. Удерживайте Ctrl для прокрутки всех подключённых шасси."
]
quest.4D999E42010FFB85.quest_desc: ["Хранит 1.6r AE в батарее и потребляет 1 AE/t за каждый блок, на который вы удалены от ближайшей ME Wireless Access Point."]
quest.4DAC24440803FE58.quest_desc: [
	"Сеть AE2 должна быть загружена в чанках, чтобы любые её устройства работали, а если загружена лишь частично, работа может быть некорректной. Spatial Anchor решает эту проблему. Он форсированно загружает чанки, в которых находится сеть. Достаточно одного кабеля, пересекающего границу чанка, чтобы загрузить новый чанк."
	""
	"Он распространяет своё «загрузка» через quantum bridges, но не межизмеренно, поэтому если есть quantum bridge в нижний мир, нужно иметь spatial anchor в сети на базе и в сети в нижнем мире."
	""
	"По умолчанию также включены случайные тики в загруженных чанках, это можно отключить в конфиге AE2."
]
quest.4DAEDB4B0C8D2CE4.quest_desc: ["Высокоскоростной генератор, который преобразует тепло или давление жидкости в вращательную энергию через турбинные лопасти. Обеспечивает эффективное и непрерывное питание для продвинутых машин и систем автоматизации."]
quest.4DD8EC6663F695BC.quest_subtitle: "Разместите Sequenced Pulse Generator"
quest.4DD8EC6663F695BC.title: "Вычислительное превосходство"
quest.4E058BAF38B16EE0.quest_desc: ["Электрический компонент, который хранит и высвобождает энергию по мере необходимости. Стабилизирует поток энергии, повышает эффективность и поддерживает машины при перепадах напряжения."]
quest.4E5C6F23628A9982.quest_desc: [
	"Encased Chain Drive — блок, передающий вращение, аналогично Mechanical Belt."
	""
	"Encased chain drives могут размещаться рядом вертикально или горизонтально, чтобы образовать цепь, передающую вращательную энергию между всеми блоками. Блоки должны соприкасаться боками (не осью) и находиться в одной линии, чтобы образовать цепь. Оси могут быть параллельны или блоки можно повернуть перпендикулярно. Цепь также может передавать вращение через вращающуюся ось, но это не продолжение той же цепи."
]
quest.4EBD5363B552085D.quest_desc: [
	"Организует электрические приборы в серии-параллельные группы без диодов или других компонентов разветвления."
	""
	"Разные номера групп работают параллельно и ведут себя так, как будто находятся на отдельных диодах."
]
quest.4EC20D5D0EEC1DF7.quest_desc: [
	"" 
	"{ \"text\": \"Нажми меня!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3617DE87C4E1BCB9\" } }"
]
quest.4EC499B88FBFA01C.quest_desc: ["Хранит кинетический стресс для последующего использования. Сохраняет заряд в виде предмета для дальнобойной транспортировки энергии. Вместимость батареи, RPM при разряде и значения воздействия стресса настраиваемы."]
quest.4F1307BB5B01F90F.quest_desc: [
	"ME Chest действует как мини-сеть с ME Terminal, ME Drive и Energy Acceptor. Может использоваться как маленькая сеть хранения, но вместимость всего одной ячейки ограничивает его применение."
	""
	"Полезен для работы с конкретной ячейкой внутри него. Интегрированный терминал видит и взаимодействует только с предметами в смонтированном диске, в то время как устройства общей сети могут получить доступ к любым хранилищам сети, включая ME Chest."
	""
	"Имеет 2 разных GUI и стороны для транспортировки предметов. Взаимодействие с верхним терминалом открывает интегрированный терминал. Предметы можно вставлять в ячейку только через этот вход, но не извлекать. Взаимодействие с другими сторонами открывает GUI с слотом для ячейки и настройками приоритета. Вставка и извлечение ячейки возможны только через лицо со слотом."
	""
	"Можно повернуть с помощью Certus Quartz Wrench."
	""
	"Имеет небольшой AE буфер энергии, поэтому при отсутствии сети с energy cell одновременное вставление или извлечение слишком большого количества предметов может вызвать кратковременное отключение."
]
quest.4F1C04C0F6769825.quest_desc: [
	"Chemical Injection Chamber использует газ Hydrogen Chloride для превращения руды в 4 Shards и Raw Ore в 8 Shards."
	""
	"Это начало 4x обработки руды и требует стабильной подачи Hydrogen Chloride, который производится только на Thermal Evaporation Plant."
	""
	"Эта машина — следующий шаг в расширении Ore Processing Factory. Разместите её слева от Purification Chamber для интеграции в существующую установку и продолжения прогрессии."
]
quest.4F1C04C0F6769825.title: "Начало Tier 3 Ore Factory"
quest.4F1FA866A2F510A1.quest_desc: ["Получено путем помещения Electrum Ingot в Rolling Mill."]
quest.4F1FA866A2F510A1.quest_subtitle: "Составной компонент"
quest.4F216AB740548F80.quest_desc: ["Мощный промышленный двигатель для генерации огромного количества вращательной энергии. Идеален для привода тяжёлой техники, крупных фабрик и продвинутой автоматизации."]
quest.4F2F6E31C38DA17F.quest_desc: ["Автоматически пополняет устройства и броню, использующие воду."]
quest.4F436770D30D8520.quest_desc: [
	"Нам нужно добавить ещё 3 машины в текущую установку."
	""
	"Chemical Dissolution Chamber — первая машина в 5x цепочке обработки руды. Превращает Raw Ore в Slurry с помощью Sulfuric Acid."
	""
	"Машина использует 100mB Sulfuric Acid на каждую руду и выдаёт 1000mB Slurry. Эту суспензию нужно промыть в Chemical Washer."
]
quest.4F436770D30D8520.title: "Начало Tier 4 Ore Factory"
quest.4F5AA576DC7B9B24.quest_desc: ["Поместите эти предметы в верхнюю часть Blast Furnace для получения расплавленной стали и шлака."]
quest.4F5AA576DC7B9B24.title: "Производство стали"
quest.4F78122BABAB041C.quest_desc: [
	"Mechanical Plough — это Movement Actor, используемый для разрушения непроходимых блоков и запуска сущностей."
	""
	"Размещение"
	"Plough можно разместить только на горизонтальной поверхности твёрдого блока, но этот блок не обязателен для поддержки после установки."
	""
	"Разрушение блоков"
	"При креплении к Contraption, Mechanical Plough разрушает непроходимые блоки (например, снежные слои). Также перемещает или запускает сущностей и вспахивает почву."
	""
	"Вспахивание"
	"При креплении к Contraption, Mechanical Plough вспахивает все блоки травы под ним (меняет траву на farmland), что удобно для быстрого вспахивания больших ферм."
	""
	"Запуск сущностей"
	"При движении Contraption с Plough, все сталкивающиеся сущности выбрасываются в направлении движения."
]
quest.4F78375EDADAFEC2.quest_subtitle: "Не забудьте средства защиты"
quest.4F89670D49DD2DE1.quest_desc: [
	"Предоставляют диагностические функции, визуализируя использование каналов на кабелях. Каналы отображаются как подсвеченные цветные линии вдоль чёрной полосы кабеля, позволяя понять использование каналов в сети."
	""
	"Первые четыре канала показываются линиями цвета кабеля, следующие четыре — белыми линиями."
	""
	"Цвета можно изменять аналогично Fluix ME Glass Cable."
]
quest.4F8BAA7B943299D9.quest_subtitle: "Смешайте никель и медь в нагретом бассейне."
quest.4FCCEB8B6A6AA643.quest_subtitle: "Составной компонент"
quest.4FFD6C191AD6FCC5.quest_desc: ["Значительно улучшенная портативная версия Electric Gauge. Очень полезно для проверки подачи тока и энергии в устройстве."]
quest.5047792C6EF6D2AD.quest_desc: ["Создано в Pressurized Reaction Chamber из 2 x Bio Fuel, Water и Hydrogen (также побочный продукт — Ethylene)."]
quest.5047792C6EF6D2AD.title: "Substrates"
quest.50CE0BD7B0BC4017.quest_desc: ["Fluid Valves можно переключать между открытым и закрытым положением, подавая вращательную силу на бок. Обычно это делается с помощью Valve Handle или Gearshift. Комплект стрелок на боковой части клапана вращается, показывая состояние клапана."]
quest.51844489E649C85A.quest_desc: ["&9Time-Dilating QIO Drive&r может содержать &o&b1,048,000&r &nпредметов&r и &o&b1,024&r &nтипов предметов&r."]
quest.51CCB7ACFD7B45F1.quest_subtitle: "Ингредиент для крафта"
quest.5243675B5E7C5618.quest_desc: ["Грапплинг «виски» позволяет цепляться за большинство поверхностей и разбрасывать себя по местности! Стиль Человека-паука."]
quest.525F25F4ADE45B50.quest_desc: [
	"ME Formation Plane работает аналогично Storage Bus, но использует мир как среду хранения. Другими словами, он размещает любой блок из фильтра прямо перед собой."
	""
	"Полезно, когда блок можно обработать простым размещением и разрушением с помощью определённого инструмента."
]
quest.52D8B15C3B75AB7F.quest_desc: [
	"Генератор потребляет SU для производства электричества. Чем быстрее вращение, тем больше напряжение и мощность до максимума 255V и 12.1kW. Далее технические детали."
	""
	"Это многоступенчатый процесс сборки, один шаг включает Winding Machine. Начните с вала и следуйте шагам:"
	""
	"Добавьте Capacitor"
	""
	"Прикрепите Heavy Plate"
	""
	"Используйте Winding Machine, намотав 75 витков медного провода"
	""
	"Добавьте Magnet"
	""
	"Прикрепите Steel Mechanism"
	""
	"Используйте Screwdriver"
	""
	"Повторите трижды для 83% шанса получить генератор."
	""
	"{@pagebreak}"
	""
	"0 RPM - 40 RPM: Электричество не генерируется"
	""
	"41 RPM - 223 RPM: Напряжение растёт линейно от 1V до 255V. Ток ограничен 40A, мощность от 40W до 10.2kW"
	""
	"224 RPM - 255 RPM: Напряжение остаётся 255V, мощность увеличивается до 12.1kW. Лимит тока повышается до 47.5A"
]
quest.52DA19C0A068BAD8.quest_desc: ["Может разрушать область 3x3, работает на топливе (уголь) и воде."]
quest.531E3FF1F2865C67.quest_desc: ["Похоже на Universal Cable, Thermodynamic Conductor — способ Mekanism передавать энергию в виде тепла (по сути, тепловая труба)."]
quest.531E3FF1F2865C67.title: "&aБазовый Thermodynamic Conductor"
quest.53C0234C053BF0CF.quest_desc: [
	"Разместите Stock Link, чтобы создать новую Logistics Network. Кликните правой кнопкой на уже установленный Stock Link перед размещением, чтобы поделиться сетью этого Link. Разместите Link на Packager, чтобы подключить инвентарь Packager к сети."
	""
	"Stock Links не имеют ограничения по дальности, но чанк, в котором они находятся, должен быть загружен, чтобы сеть могла их видеть."
	""
	"Stock Links могут принимать и передавать запросы через Logistics Network."
]
quest.53DCD54202753184.quest_desc: ["Прочный компонент дрели из латуни, предназначенный для повышения эффективности и точности добычи. Идеально подходит для апгрейда дрелей для более плавного и быстрого разрушения блоков."]
quest.53EA40114B347A83.quest_desc: [
	"Огнестойкие ванны требуются в конфигурации 3x3x2."
	""
	"Необходимо использовать графитовые электроды и убедиться, что CO2 откачан."
	""
	"Держатели электродов требуют минимум 25A для работы, но имеют втрое большее сопротивление, чем электролизер. Каждый должен получать минимум 31,5 kV. Это можно достичь с помощью двух генераторов максимальной скорости, трансформатора с коэффициентом 6 и диодов на каждом держателе."
]
quest.53EA40114B347A83.title: "Дуговая печь (Arc Furnace)"
quest.5435BF11EB742A73.quest_subtitle: "Сломайте Shear Pin"
quest.5435BF11EB742A73.title: "Щёлк!"
quest.54589F10802DFE16.quest_desc: ["Сцепление, которое разъединено, если не подано питание."]
quest.546F7FF099D2696E.title: "&dUltimate Pressurized Tubes"
quest.54778BD66812A1CF.quest_desc: ["Компонент для транспортировки жидкостей между резервуарами, машинами и двигателями. Разработан для эффективной интеграции с механическими системами Create, обеспечивая плавную передачу жидкости в автоматизированных установках."]
quest.554102109E795CD3.quest_desc: ["Электрический компонент, ограничивающий или контролирующий поток тока в цепи. Критически важен для защиты устройств и обеспечения стабильного распределения энергии."]
quest.556D9C78EFAB5091.quest_desc: [
	"ME Terminal — это HUD, который даёт доступ к предметам в вашей ME сети. Включает предметы, доступные через ME Storage Bus."
	""
	"Имеет возможность сортировки и поиска, а также фильтрации через View Cell. Требует Channel для работы."
]
quest.55749230931993F2.quest_desc: [
	"В основном прозрачное стекло, созданное из Certus Quartz Dust."
	""
	"Можно использовать для изготовления Vibrant Quartz Glass и других предметов."
]
quest.55E2F8C6A71E7328.title: "&9Elite Thermodynamic Conductor"
quest.563A3503CD040E41.quest_desc: ["Скатанная катушка, создающая магнитное поле при подаче энергии. Необходима для создания моторов, генераторов и других сложных электромеханических систем."]
quest.563A3503CD040E41.quest_subtitle: "Изготовлено на Winding Machine"
quest.566C0FA15F2021F1.title: "Стальные слитки (Steel Ingots)"
quest.566D6390193DD77D.quest_desc: [
	"Brass Tunnels можно использовать на механических лентах для четырёх функций: 1) чисто декоративная, 2) разделение потоков предметов на несколько направлений, 3) сортировка потоков предметов, 4) объединение нескольких потоков предметов. Каждая труба может иметь входной или выходной портал. Статус входа или выхода зависит только от направления ленты, касающейся конкретной стороны."
	""
	"Трубы, установленные рядом, автоматически обрабатываются как группа, обычно собирая все входы и распределяя на все выходы. Распределение предметов контролируется настройкой значения трубы. Стэки предметов с разных входов не объединяются перед распределением."
]
quest.57175CF690ADCCBE.quest_desc: [
	"Bottling Machine не имеет GUI. RF подаётся через верхний задний центральный блок мультиблока (где был Light Engineering Block)."
	""
	"Жидкости добавляются через нижний средний блок сзади. Предметы добавляются, если их бросить на конвейерные ленты машины. Если вводится ёмкость с жидкостью (например, Bucket или Jerrycan), машина заполнит и выдаст её, потребляя часть RF."
	""
	"Bottling Machine заполняет каждый контейнер до 32 ведер (32,000 mB) жидкости за проход. Если контейнер может вместить больше или машина исчерпала жидкость, он будет частично заполнен и может потребовать повторного конвейерного обхода для полного заполнения."
]
quest.57175CF690ADCCBE.title: "Bottling Machine"
quest.575039EFF672065E.title: "Vacuum Tube"
quest.576873A2E3A4D8ED.quest_subtitle: "Treated Wood Planks — это деревянные доски, покрытые креозотным маслом, используемые во многих предметах Immersive Engineering."
quest.576873A2E3A4D8ED.title: "Обработанная древесина (The Treated Wood)"
quest.57E30971FCEF6709.quest_desc: [
	"Atomic Disassembler — это универсальный инструмент Mekanism, по сути, электронная версия пикселя (paxel)."
	""
	"Инструменты, которые заменяет Atomic Disassembler:"
	"Pickaxe"
	"Axe"
	"Shovel"
	""
	"Инструменты, которые Atomic Disassembler не заменяет:"
	"Shears"
	"Saw"
	"Sword — хотя и мощное оружие, наносящее в среднем 20 единиц здоровья, Atomic Disassembler не может использоваться для атаки взмахом."
	""
	"{@pagebreak}"
	""
	"Atomic Disassembler имеет пять режимов, между которыми можно переключаться Shift + Правый клик или через назначенную клавишу Item mode switch:"
	"Normal (202)"
	"Стандартный режим"
	"Работает как алмазная версия всех инструментов с Efficiency II."
	"Slow (82)"
	"Работает как алмазная версия всех инструментов."
	"Fast (1282)"
	"Работает как алмазная версия всех инструментов с Efficiency V."
	"Off (02)"
	"Не влияет на окружающий мир, кроме мобов."
	"Хороший режим для оружия по умолчанию, если не хотите случайно вырыть себе яму смерти."
]
quest.57FCBFBA8789F893.quest_subtitle: "Работает под водой."
quest.587A19FC348387C5.quest_desc: [
	"Pressurized Reaction Chamber (PRC) используется для создания Substrate (для HDPE Pellets), HDPE Pellets (для HDPE Sheets) и Ethylene (эффективное топливо для Gas-Burning Generator). Скорость и энергопотребление зависят от создаваемых материалов/газов."
	""
	"PRC принимает жидкость, газ и материал(ы); используя эти три вещества, создаётся другой материал(ы) и остаётся газ. Как и многие другие машины Mekanism, имеет настраиваемые стороны; по умолчанию принимает газ слева, жидкость сзади и выводит газ справа."
]
quest.58B125BD4876054C.quest_desc: [
	"Мод добавляет множество средне- и высокоуровневых машин, генераторов и инструментов, создавая новый элемент технологий в игре, изначально ориентированной на выживание."
	""
	"Мод фокусируется на разложении материалов на химические элементы и максимально эффективном использовании каждого материала."
	""
	"В моде представлены водородные реактивные ранцы, мини-робот, реакторы, цифровой майнер для автоматизации добычи, реакторы и многое другое."
]
quest.58B125BD4876054C.title: "Добро пожаловать в Mekanism"
quest.5921FE935A2D7325.quest_desc: ["Alloy Kiln довольно прост в использовании; помещайте твёрдое топливо в нижний слот GUI для питания печи. Два других левых слота предназначены для добавления слитков или Grit для создания нового слитка. Через ~8 секунд формируются два новых слитка."]
quest.5921FE935A2D7325.title: "Alloy Kiln"
quest.5A14292FE47ED873.quest_desc: ["Точно изготовленный компонент, который улавливает поток жидкости или воздуха для генерации вращательной энергии. Ключевая часть турбинных двигателей, обеспечивает плавное и эффективное преобразование энергии."]
quest.5A2450162FD24F7E.quest_desc: [
	"Два Crushing Wheels должны быть установлены рядом друг с другом горизонтально или вертикально на расстоянии одного блока. Каждому колесу нужно придать противоположное вращение. Любые предметы, предназначенные для измельчения, должны быть вставлены с той стороны, где колёса вращаются внутрь."
	""
	"Crushing Wheels можно автоматизировать, установив воронку сверху прямо между колесами и либо депо, либо конвейер снизу."
]
quest.5A2450162FD24F7E.quest_subtitle: "Crushing Wheels применяют рецепты Crushing к любым предметам, вставленным с направления вращения колеса наружу."
quest.5A2450162FD24F7E.title: "Crushing Wheels"
quest.5A5A30CD4D0C98CB.quest_desc: ["Fluix Crystal создаётся в мире путём броска Charged Certus Quartz Crystal, Nether Quartz и Redstone Dust в воду."]
quest.5AFD4912CC8FBBB8.quest_subtitle: "Рецепт создания"
quest.5B3FDF651D845DF1.title: "&9Elite Mechanical Pipe"
quest.5B681BC43371CC5C.quest_desc: [
	"Logistical Transporter — это базовая труба для транспортировки предметов в Mekanism Logistics. С помощью Configurator игрок может «окрасить» трубу цветом, который распознается сортировщиком цвета трубы, зажав ⇧ Shift + правый клик по центру транспортера с Configurator."
	""
	"У него есть два «родственника»: Diversion Transporter и Restrictive Transporter."
]
quest.5B681BC43371CC5C.title: "&aБазовый Logistical Transporter"
quest.5B9501552E5DFB20.quest_subtitle: "Встречается в жилках рядом с поверхностью вместе с Crimsite и песком."
quest.5B960A074B904E80.quest_desc: [
	"Электродвигатель преобразует электрическую энергию в SU с небольшими потерями эффективности."
	""
	"Это многошаговый рецепт сборки, один из шагов включает Winding Machine. Начните с вала и выполните следующие действия:"
	""
	"Обмотайте 75 витков медного провода с помощью Winding Machine"
	""
	"Добавьте магнит"
	""
	"Прикрепите стальной механизм"
	""
	"Используйте отвертку"
	""
	"Повторите этот процесс трижды для 94% шанса получения мотора."
	""
	"Направление вращения можно настроить."
	""
	"Для 30V - 320V: выход SU и скорость мотора зависят от входного напряжения, до 11,220 SU при 255 RPM. Потребляется 960W мощности."
	""
	"Для 320V - 1000V: мотор по-прежнему производит максимальный SU, но потребляет больше энергии. Преимуществ при этом нет."
]
quest.5C2108BD3DEEB0E6.quest_desc: [
	"Spout — блок, используемый для заполнения жидкостями контейнеров (бутылок, ведер) или для крафта с жидкостями."
	""
	"Spout может быть заполнен до 1 ведра любой жидкости через Fluid Pipes и выдает часть жидкости на совместимые предметы, проходящие под ним через Conveyor Belt или Depot."
	""
	"Spout обрабатывает предмет за 1 секунду, независимо от объема жидкости, хотя задержка между заполнениями может быть вызвана временем на повторное наполнение Spout."
]
quest.5C21D02BB2644A39.quest_desc: [
	"Несмотря на описание, всё ещё требует Magnetic Alloy."
	""
	"Подключите его к генератору, поместите один сплав на штырях и наблюдайте, как стрелка поднимается до создания магнита."
]
quest.5C5DE3ECE4E39C5F.quest_subtitle: "Активируйте Overstress Clutch"
quest.5C5DE3ECE4E39C5F.title: "Circuit Breaker"
quest.5D3EE44FB41D289F.quest_desc: ["Предмет, содержащий конфигурацию, аналогичную Storage Cell, позволяющий настраивать фильтрацию конкретного ME Terminal."]
quest.5E116409DC7D30BB.quest_desc: ["Configurator используется для настройки многих предметов Mekanism: от изменения труб до режима \"Pull или Push\" или вращения машин."]
quest.5E2F9E27E6B4DF74.title: "&dUltimate Thermodynamic Conductor"
quest.5EB59B43781EB61D.quest_desc: [
	"Используйте Wrench, чтобы переключать вход и выход."
	""
	"Вход обозначен синим соединением, выход — оранжевым."
	""
	"При конвертации FE в TFMG энергию напряжение можно установить до 250V."
]
quest.5F0E877BE50D79D0.quest_desc: ["Используется с &6Spatial IO Port&r для хранения пространственных регионов."]
quest.5F68F1D8533B534F.quest_subtitle: "Кликните по Industrial Mixer для установки."
quest.5FDB48511EC1C580.quest_desc: [
	"Боишься взрыва &6Fission Reactor&r и масштабного &4Radiation&r утечки?"
	""
	"Как предотвратить такую катастрофу? Создать redstone &aCircuit Breaker&r с помощью &dFission Reactor Logic Adapters&r. Они не гарантируют 100% предотвращение взрыва, но крайне полезны."
	""
	"Эти адаптеры позволяют управлять &6Reactor&r с помощью &cRedstone&r. Один адаптер позволяет включать &9и выключать&r реактор с помощью рычага. Мы же используем их для контроля повреждений."
	""
	"Можно настроить их на выдачу &cRedstone Signal&r при определённых условиях в &6Reactor&r, например &cDamage Critical&r или &8Insufficient Fuel&r. Это полезно для автоматического отключения реактора при критических событиях."
]
quest.5FDB48511EC1C580.title: "&eБезопасность прежде всего!"
quest.603877AB96321F1A.quest_desc: [
	"Thermal Evaporation Plant или Solar Evaporation Plant с добавлением Advanced Solar Generators — мультиблочная структура, превращающая воду в Brine, а Brine \\& Lithium с помощью второй TEP."
	""
	"Чтобы ускорить производство, игрок должен подать источник тепла в клапан. Наиболее просто — установить резистивный нагреватель рядом с клапаном. Установив потребление энергии на 1250 FE/t, вы получите максимальное ускорение, превышение не даёт эффекта."
]
quest.603877AB96321F1A.title: "Thermal Evaporation Plant"
quest.605C0B84DFC1A4D5.quest_desc: [
	"Gantry Carriages — Contraption, который сталкивается с неподвижными блоками на своём пути."
	""
	"Разместите Gantry Shafts вдоль пути Carriage. Подайте вращение на валы для движения Carriage вперёд, инвертируйте питание для обратного движения. Инвертируя размещение валов, инвертируется всё движение. Wrench помогает менять ориентацию."
	""
	"При 1rpm вращения Carriage движется со скоростью 0.03846 блоков/сек вдоль вала."
	""
	"Примените Redstone сигнал к валу, чтобы остановить Carriage и передать вращение через выход Carriage. Это можно использовать для движения другого Carriage."
	""
	"Gantry Shafts, подключённые к выходу Carriage, будут двигаться вместе с ним."
	""
	"Несколько Carriage на одном валу могут перемещать одну и ту же конструкцию."
]
quest.60844520BAC54952.quest_desc: [
	"Разместите sample drill и подключите к нему oxygen backtank, затем активируйте drill."
	""
	"Кликните по нему Atlas, чтобы получить информацию о жиле руды."
]
quest.60DBF181ED929607.quest_desc: ["Заряжает предметы под ним и может использоваться для нанесения урона игрокам и мобам."]
quest.60F40F9349D3F369.quest_desc: [
	"На этом всё! Вы достигли конца прогрессии Mekanism в этом модпаке."
	""
	"На данный момент нет дополнительных аддонов или расширений Mekanism, поэтому это предел вашей фабрики. Вы освоили все этапы переработки руды и автоматизации — впечатляющее достижение!"
	""
	"Продолжайте исследовать, экспериментировать и интегрировать Mekanism с другими модами, чтобы ещё больше улучшить производство. Кто знает, какие улучшения появятся в будущем?"
]
quest.60F40F9349D3F369.title: "Что дальше?"
quest.61348E2551E8AD6C.quest_desc: [
	"Для работы Rotation Speed Controller его необходимо соединить с Large Cogwheel. Rotation Speed Controller, получая питание от Large Cogwheel, выдает желаемую скорость вращательной силы с любых сторон. Он также работает наоборот: при подаче питания с боков он контролирует скорость Large Cogwheel."
	""
	"Скорость вращения и направление можно изменить на экране Value Settings спереди или сзади машины. Максимальная скорость — 256 оборотов в минуту по часовой или против часовой стрелки."
]
quest.6177966365A058A2.quest_desc: [
	"Стальные ванны требуются в конфигурации 2x2x2 и должны быть нагреты."
	""
	"Можно использовать электроды из меди или цинка. Обязательно удаляйте CO2."
	""
	"Держатели электродов требуют минимум 25A для работы, то есть каждый должен получать как минимум 3500V. Это можно сделать с помощью одного генератора максимальной скорости и трансформатора с коэффициентом 4."
]
quest.6177966365A058A2.title: "Электролиз"
quest.618ECDB3FB534A8A.title: "&cAdvanced Universal Cables"
quest.621F052BCE747E68.quest_desc: [
	"Кабель повышенной пропускной способности, может передавать 32 канала, в отличие от стандартного кабеля, который передает только 8."
	""
	"Однако он не поддерживает шины, поэтому сначала нужно понизить сигнал с dense кабеля на меньший (например, Fluix ME Glass Cable или Fluix ME Smart Cable) перед использованием шин или панелей."
	""
	"Показывает нагрузку аналогично Fluix ME Smart Cable: каждая подсвеченная линия представляет четыре используемых канала."
]
quest.626580DB654F128D.quest_desc: ["Мельница способна выполнять рецепты помола для любых предметов, вставленных сверху."]
quest.62671BDA7C583957.quest_desc: ["Природное топливо, получаемое из органических материалов. Может быть переработано в Bioethanol — экологически чистый источник энергии для устойчивой работы машин Create."]
quest.629BCF8065DFD8B1.quest_subtitle: "Используйте для поиска чанка с жилой руды"
quest.62BAE54B507B7A21.quest_subtitle: "Рецепт создания"
quest.62F1177325B16068.quest_desc: ["Высокий ток"]
quest.6350ADB7540C368D.quest_desc: [
	"Если Smart Observer установлен лицом к контейнеру (Mechanical Belt, Funnel или Fluid Pipe), он выдаст сигнал Redstone при обнаружении предмета внутри. Smart Observer также срабатывает, если блок перед ним соответствует фильтру."
	""
	"Если к Smart Observer применён фильтр, сигнал будет выдаваться только при обнаружении предмета из фильтра."
]
quest.637EBAB0500A2295.quest_desc: ["Зажигательная граната, которая при попадании вызывает высокотемпературную химическую реакцию, плавя металл и воспламеняя рядом стоящие горючие материалы. Наносит постоянный урон в области действия, может выводить из строя механизмы или пробивать укреплённые конструкции. Используйте осторожно — её интенсивное тепло поражает как друзей, так и врагов."]
quest.63B4B83F528E6AD6.quest_desc: ["{ \"text\": \"Кликни меня!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4CFE8B1C53B429E9\" } }"]
quest.63E8F78EEA3063F7.quest_desc: ["{ \"text\": \"Кликни меня!\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"24DDED464AE48E05\" } }"]
quest.6424D99CBA76895B.title: "&9Elite Pressurized Tubes"
quest.64AB5CCDD9860DD8.quest_desc: ["Получается помещением Iron Sheet в Rolling Mill."]
quest.64AB5CCDD9860DD8.quest_subtitle: "Рецепт создания"
quest.66108B4F2DBF2E3F.quest_desc: ["Получается помещением Copper Ingot в Rolling Mill."]
quest.66108B4F2DBF2E3F.quest_subtitle: "Рецепт создания"
quest.66A35D1A11CBB671.quest_subtitle: "Соберите Control Chip"
quest.66A35D1A11CBB671.title: "Precision Fabrication"
quest.66C3C169307A8025.quest_desc: ["Позволяет игроку летать, быстрее перемещаться и плавать. Работает с водой."]
quest.66D9F91519D52482.quest_desc: ["Blaze Cake — предмет, который можно дать Blaze Burner, чтобы сделать его Super-Heated."]
quest.673FCBF8685D0EEE.quest_desc: [
	"&bInduction Matrix&r — высококонфигурируемая мультиблочная структура для хранения энергии."
	""
	"Необходимо построить прямоугольный призматический каркас. Ребра из &8Induction Casings&r. Лица из Casings, &aStructural Glass&r или &eInduction Ports&r. Лучше иметь &b&o2 Ports&r: один для &9input&r и один для &coutput&r. Их можно менять с помощью &dConfigurator&r."
	""
	"Для этого сборки мы делаем 5x5x5. Квест требует точное количество материалов для постройки."
	""
	"{image:kubejs:textures/item/induction.png width:100 height:100 align:1}"
]
quest.673FCBF8685D0EEE.title: "&bInduction Matrix"
quest.67F7FBDD9CC782F7.quest_desc: [
	"Существуют три уровня ванн:"
	""
	"Чугунные"
	"Стальные"
	"Огнеупорные"
	""
	"Каждый уровень имеет свои ограничения: некоторые рецепты работают только с ванной определённого уровня или выше."
	""
	"Миксеры и центрифуги просты — им нужна всего одна ванна. Но для тяжелых установок, как Electrolyzer или Arc Furnace, нужны большие ванны. Минимальные размеры (ДxШxВ) указываются при необходимости."
	""
	"Некоторые процессы требуют нагрева, и одного Blaze Burner недостаточно. Потребуются несколько горелок или супернагретая установка. Fireboxes действуют как постоянно супернагретые Blaze Burner, идеально подходят."
	""
	"Совет: возьмите Wrench и загляните внутрь ванны!"
]
quest.67F7FBDD9CC782F7.title: "Chemical Vat"
quest.6819665DA7028C9E.quest_subtitle: "Рецепт создания"
quest.6832CFEAFA7922E8.quest_desc: ["Устройство, создающее огромное напряжение при подаче питания, останавливая сеть из-за перегрузки."]
quest.68331DDD9F01BDC5.quest_desc: [
	"Работает с топливом."
	"Если есть топливо, можно сжечь что угодно!!!"
]
quest.6847F5D14FCB5BF8.quest_desc: [
	"Используйте Meteorite Compass для поиска Skystone Meteorites, которые могут содержать Quartz и Budding Quartz."
	""
	"Максимальная дальность примерно 2700 блоков."
]
quest.68E50F7501B945BB.quest_desc: ["Легкий металл с высокой энергией, ценится за отличную проводимость и использование в аккумуляторах и электронных компонентах. Используется в высокотехнологичном крафте и хранении энергии, где важна плотность энергии и малый вес."]
quest.69816C16E81355E8.quest_desc: ["Муфта, которая разъединяется после заданной задержки при перегрузке сети."]
quest.6A4CF3A1CF4D4928.quest_desc: [
	"Charger позволяет заряжать поддерживаемые инструменты и Certus Quartz Crystal."
	""
	"Энергия может подаваться сверху или снизу через кабели AE2 или другие кабели модов. Принимает AE (AE2) или Forge Energy (FE). Предметы можно вставлять и извлекать с любой стороны. Результаты можно извлекать, фильтры не нужны для предотвращения вытаскивания исходного кристалла. Можно вращать с помощью Certus Quartz Wrench для автоматизации."
	""
	"Можно создавать Charged Certus Quartz Crystal из Certus Quartz Crystal и Meteorite Compass из Compass."
	""
	"Для ручного питания поставьте Wooden Crank сверху или снизу и кликните, пока предмет не зарядится."
]
quest.6A539510EEB5F29E.quest_subtitle: "Кликните Hardened Planks с Steel Ingot."
quest.6A84FC7CC5304E10.quest_subtitle: "Рецепт создания"
quest.6B20F8F08E5F3848.quest_desc: ["Кинетический генератор, преобразующий тепло и воду в вращательную энергию. Надёжный способ питания машин и систем автоматизации с постоянным выходом."]
quest.6B5C3E68A6A3F3B5.quest_desc: [
	"Spatial Pylon используется в Spatial IO для генерации пространственного поля и определения объёма воздействия."
	""
	"Каждая непрерывная линия pylons использует 1 канал."
	""
	"Линии pylons должны быть как минимум 2 блока в длину для работы."
]
quest.6B7188472F6ED6AF.quest_desc: ["Позволяет redstone-связям соответствовать любой частоте для слота, в котором они установлены."]
quest.6B7DE9EA8E828DEE.quest_desc: [
	"Inscriber создаёт различные типы Processors."
	" "
	"Inscriber также может \"создавать\" прессы, дублируя существующий пресс с помощью Iron Block."
]
quest.6B8966D7EA9BB5FB.quest_desc: ["Ручные рукояти с установленной шестернёй."]
quest.6B8E544E188FBA4D.quest_subtitle: "Сердце вашей системы"
quest.6BEC1C688BC24782.quest_desc: [
	"С взаимозаменяемыми Drill Heads и улучшениями его характеристики почти полностью изменяемы."
	""
	"Чтобы модифицировать его, разместите в Engineer's Workbench."
	""
	"Drill работает на Biodiesel и может быть заправлен напрямую через Refinery."
]
quest.6C25D42C36175BF4.quest_desc: [
	"Purification Chamber использует кислород для переработки руд и осколков в Clumps. Каждая руда даёт 3 clumps, каждый осколок — 1 clump."
	""
	"Кислород можно подавать извне как газ, или изнутри через Gas Tank с кислородом или с помощью кремня. (См. страницу с газами, как сделать кислород)"
	""
	"Пример: Copper Ore → 3 Copper Clump."
	"Clumps можно поместить в Crusher, получив грязную руду, которую затем обогащают в Enrichment Chamber, чтобы получить обычную пыль."
	""
	"Также можно превратить гравий в кремень."
]
quest.6C25D42C36175BF4.quest_subtitle: "Создаёт Clumps"
quest.6C8431C216A66C1F.title: "&dUltimate Logistical Transporter"
quest.6C9157A690AA5F3C.quest_subtitle: "Не пейте это."
quest.6CD96328B7567F46.quest_desc: ["Mechanical Harvester собирает все зрелые культуры, с которыми сталкивается при движении вперёд."]
quest.6D03D3B4D83C1840.quest_desc: [
	"Кликните по фронту Mechanical Crafter с помощью Wrench, чтобы изменить направление, в которое отправляются предметы при крафте."
	""
	"Mechanical Crafters можно автоматически заполнять через Funnels или Hoppers."
	""
	"На задней и боковых сторонах Mechanical Crafters Wrench позволяет соединять или разъединять инвентарь двух соседних крафтеров. Крафтеры могут делиться инвентарями, даже если не участвуют в одном рецепте."
	""
	"{@pagebreak}"
	""
	"Предметы можно вставлять или извлекать вручную."
	""
	"Каждый Mechanical Crafter имеет внутреннюю шестерню, которую можно вращать только через соседние Mechanical Crafters или Cogwheel любого размера. Это значит, что в цепочке только один крафтер нужно питать через Cogwheel."
	""
	"При подаче вращательной силы и при наличии Redstone или заполнении всех слотов крафтера, Mechanical Crafters отправят предметы соседним крафтерам. Для успешного рецепта все предметы должны попасть в один крафтер. Как только все предметы достигнут конечного крафтера, они превратятся в продукт."
]
quest.6D7CC9EA47063963.quest_desc: ["Лёгкий и прочный металлический слиток для крафта сложных машин и компонентов. Прочность и проводимость делают его идеальным для высокотехнологичных и промышленных применений."]
quest.6D7CC9EA47063963.quest_subtitle: "Алюминий, братан"
quest.6DB1AAAD926486BC.quest_desc: [
	"&aFluid Tanks&r — блоки для хранения жидкостей."
	""
	"Объём жидкости (мб), который может хранить tank, зависит от его уровня."
	""
	"При разрушении tank сохраняет инвентарь. Можно использовать &dMechanical Pipe&r с режимом &cPull&r для извлечения жидкости."
	""
	"Есть режим &o&bbucket&r, позволяющий черпать жидкости. Очень полезно для &6лавы&r на раннем этапе!"
]
quest.6DE8ACA4F08C420E.quest_desc: ["Передаёт stress capacity из одной сети в другую, сохраняя их разделёнными. Гарантирует, что исходная сеть не пострадает при перегрузке целевой сети."]
quest.6E8C6A4A07957E5A.quest_desc: [
	"При подаче Rotational Force на Hose Pully он может вытягивать шланг бесконечно. Изменение направления силы вращения втягивает шланг обратно к блоку. Шланг должен быть вытянут минимум на один блок для работы."
	""
	"Для откачки или подачи жидкости требуется Fluid Pump."
	""
	"-Если жидкость откачивается, уровень падает до конца шланга. Если несколько hose pulleys берут из одного источника, процесс ускоряется при сохранении пропускной способности трубы."
	""
	"-Если жидкость подаётся, она затапливает помещение любого размера, шланг указывает максимальную высоту затопления."
]
quest.6E95E958201D50BE.quest_desc: [
	"Личный сундук раньше назывался \"Electric Chest\" и мог блокироваться электричеством. Теперь это Personal Chest и электричество не требуется. Можно заблокировать и установить \"trusted\"."
	""
	"Сундук можно ставить и использовать как обычный. Сундук имеет вместимость double-chest, но пространство одного сундука. Клик по воздуху открывает сундук. С помощью Logistical Transporter предметы можно подавать и извлекать."
]
quest.6F62B5510FA881CD.quest_subtitle: "Рецепт создания"
quest.6F62B5510FA881CD.title: "Osmium"
quest.6FE2FE40C2F60183.quest_desc: ["Передаёт вращение в двух направлениях независимо."]
quest.6FFC4582D3620F32.quest_desc: ["Простое управляющее устройство для замыкания или размыкания электрической цепи. Позволяет точно запускать, останавливать или перенаправлять поток энергии к машинам, свету и автоматическим системам."]
quest.7111C78368C786CD.quest_desc: ["Частично собранная катушка, ожидающая изоляции или сборки. Промежуточный компонент для создания полностью функционирующих электромагнитных устройств и генераторов."]
quest.713EA1BC9BAAA0AB.quest_desc: [
	"Molecular Assembler берёт предметы и выполняет операции, заданные соседним ME Pattern Provider или вставленным Crafting Pattern, Smithing Table Pattern или Stonecutting Pattern, затем отправляет результат в соседние инвентари."
	""
	"У этого ассемблера есть рецепт 1 oak log = 4 oak planks. Когда дубовые бревна подаются в верхний hopper, ассемблер создаёт дубовые доски и выдаёт их в нижний hopper."
]
quest.717CA8EB4DF4EDB8.quest_desc: ["Действует как Blaze Burner, но с топливом и CO2. Дополнительно можно использовать Blaze Burners со Straw."]
quest.719218CEA358D540.quest_desc: ["Клик по земле ставит Train Track от себя. Рельсы можно размещать в 8 направлениях (четыре основных направления и 45° между ними). Рельсы можно ставить на боковые стороны блоков без блока над ними. Рельсы имеют 45° вертикальный уклон. Разрушать рельсы можно любым киркой или кликом с Wrench, присев. Другие предметы уничтожают рельс без возврата."]
quest.71A772DE60643C45.title: "The Inscriber Presses"
quest.71EDE15818D4C2A1.quest_desc: ["Blast Furnace может быть любой высоты. Более высокие печи плавят сталь быстрее."]
quest.71EDE15818D4C2A1.title: "Blast Furnace"
quest.71FB3EA8CB37A038.quest_desc: ["Применяется на Blaze Burner для сжигания жидкого топлива, некоторые могут супернагревать Blaze Burner на более длительное время."]
quest.7322A19FDA5B78E1.quest_desc: ["Valve Handle работает как Hand Crank, однако количество и направление поворота можно настроить через Value Settings Screen."]
quest.732D1A96512F2BFD.quest_desc: [
	"Steam Engine — блок, создающий Rotational Force."
	""
	"Обеспечивает наибольшую вместимость Stress Unit (SU) среди всех блоков генерации энергии в survival mode."
	""
	"Преобразует давление, возникающее при нагреве воды в Fluid Tank, в Rotational Force, позволяя питать большие производства и механизмы."
	""
	"Приготовьтесь к большому количеству текста."
	""
	"{@pagebreak}"
	""
	"Steam Engines используют нагретую воду для энергии и устанавливаются на Fluid Tanks, которые работают как котёл. Shaft можно использовать для получения кинетического выхода. Направление выхода регулируется через Value Settings сбоку."
	""
	"Для увеличения мощности нужно увеличить один или несколько параметров котла (heat, size, water). Увеличение минимального уровня среди трёх характеристик повышает максимальный SU, который Steam Engine может получить. Один Steam Engine может извлечь максимум 16,384 SU (эквивалент 1 уровня котла). Чтобы повысить мощность, можно подключить несколько Steam Engines к одному котлу; это не увеличивает общую мощность котла."
	""
	"{@pagebreak}"
	""
	"Размер tank — базовая характеристика котла. Требуемые размеры зависят от подаваемого тепла. Для пассивного двигателя (level 0) котёл должен быть 2x2 блока по высоте. Для активного (level 1+) нужно 4 блока на уровень тепла. Пример: level 1 → 4 блока, level 9 → 36 блоков, level 18 → 72 блока."
]
quest.735412C77BE7A82A.quest_desc: [
"Жидкости подаются в миксер через порт внизу его источника питания. Предметы можно подавать через два люка сзади. Фронтальный порт жидкости служит для вывода жидкости."
""
"Применение сигнала редстоуна к панели управления спереди остановит процесс машины, это поведение можно инвертировать с помощью Отвертки инженера."
]
quest.735412C77BE7A82A.title: "Миксер"
quest.738FF04BEE2342A0.quest_desc: [
"&eMeka-Tool&r — это &o&bmulti-use&r инструмент в &dMekanism&r."
""
"По умолчанию он почти не имеет функций, но можно установить &9Модули&r, чтобы дать ему широкий спектр возможностей. Хотя &aConfigurator&r необходим для крафта &eMeka-Tool&r, сам он такой функции не имеет."
]
quest.743C84D1D94C5670.quest_desc: ["Латунная воронка — блок, который может извлекать или вставлять предметы в инвентари"]
quest.74DA690631920E06.quest_subtitle: "Сделано как обычные кирпичи."
quest.74FE4BDF6CEFAA42.quest_desc: ["Механическая система, которая передает и регулирует вращательную мощность между двигателями и механизмами. Обеспечивает оптимальную скорость, крутящий момент и эффективность на всех соединенных компонентах."]
quest.7522F2DC9038ED92.title: "&cПродвинутый термодинамический проводник"
quest.7553689BC9202E14.title: "&9Элитные универсальные кабели"
quest.75A28517E08FE190.quest_subtitle: "Поставьте латунный редуктор"
quest.75A28517E08FE190.title: "Серьезная организация"
quest.75C0ED308F5D7417.quest_desc: [
"&3MekaSuit&r — это высококонфигурируемый комплект модульной брони поздней игры, добавленный в &dMekanism&r."
""
"&3MekaSuit&r разделен на &o&b4&r части: шлем, нагрудник, поножи и ботинки."
""
"Каждую часть &3MekaSuit&r можно улучшать с помощью &eМодулей&r, которые устанавливаются через &6Станцию модификации&r и настраиваются нажатием "&b\&r" (обратная косая черта)."
""
"Она считается лучшей броней в &dMekanism&r и очень дорога в изготовлении и &o&bполной прокачке&r, даже для игроков поздней игры, требуя большое количество &9Полония&r для переработки в гранулы."
""
"С полностью улучшенным костюмом носитель становится &nпочти&r &6неуязвимым&r."
]
quest.75E7216AB5411DF6.quest_desc: [
"Механические пилы получают питание от вращательной силы, и при установке вбок они автоматически срубают блоки дерева перед собой. При рубке дерева или гигантского гриба, автоматически уничтожается всё дерево, начиная с самого нижнего блока."
""
"Механические пилы предназначены для вырубки деревьев 2x2, если хотя бы последний блок (по горизонтали) был разрушен пилой. Самый простой способ обойти это — удалить блок прямо над разрушаемым, тогда вся структура 2x2 будет срублена."
""
"Механические пилы могут рубить любые конструкции из бревен, если нет вертикального квадрата 2x2 с разрушаемым блоком внизу."
""
"Механические пилы автоматически получают питание, если находятся на Create Contraption. Пила наносит урон сущностям и разрушает блоки с определенной скоростью в зависимости от скорости конструкции."
]
quest.7653935BDE025D18.quest_desc: [
"&dАкваланг&r — это оборудование, надеваемое на спину (слот нагрудника), которое обеспечивает подводное дыхание при ношении &eМаски акваланга&r (шлем)."
""
"Как и &cДжетпак&r, &dАкваланг&r должен быть заполнен газом &3Кислород&r для работы."
""
"&eМаска акваланга&r — утилитарный шлем, используемый вместе с &dАквалангом&r для дыхания под водой."
]
quest.7653935BDE025D18.title: "Снаряжение для подводного плавания"
quest.768789FEB6EBB8F8.quest_desc: [
"Blaze Burner — это нагревательный компонент, необходимый для некоторых рецептов Mixing. Он может использоваться для нагрева Steam Engines, Bulk Smoking, Bulk Smelting, а также как декоративный источник света."
""
"Нагрев: Blaze Burners используются для нагрева и сверхнагрева Basin при рецептах Mixing, особенно при изготовлении латуни. Также могут использоваться как источник тепла для котлов, питающих Steam Engines. Когда над топливным Blaze Burner ставится блок, способный нагреваться, Burner показывает передачу тепла блоку."
""
"Правый клик по Blaze Burner с любым предметом, который можно использовать как топливо для печи, временно переводит его в Heated состояние. Правый клик с Blaze Cake временно переводит его в Super-Heated состояние."
]
quest.768F9EBD3E115CA6.title: "&cПродвинутые прессованные трубы"
quest.76919513DA354DBC.quest_desc: [
"Редуктор — блок для передачи вращательной мощности в 4 направлениях, горизонтально или вертикально."
""
"Редуктор может передавать вращение в 4 горизонтальных направлениях. Вертикальный аналог передает вращение в 4 вертикальных направлениях."
""
"При подаче на любой входной бок (боки с формой вала) редуктор выдает/передает вращение в противоположном направлении на всех остальных боках (вход по часовой стрелке → выход против часовой, и наоборот)."
]
quest.76A38CCA5816CDAD.quest_desc: ["Сочетание кислорода, этилена и субстрата в Pressurized Reaction Chamber создаёт гранулу HDPE."]
quest.76A38CCA5816CDAD.title: "Гранулы HDPE"
quest.7700E08416618198.quest_desc: [
"Интерфейсы ведут себя как небольшой сундук и резервуар для жидкости, которые заполняются и опустошаются из сети хранения в зависимости от настроек слотов. Они стараются завершить это за один тик игры, заполняя или опустошая до 9 стеков за тик, что делает их быстрым способом импорта или экспорта с быстрыми трубами для предметов."
""
"Ещё одно полезное свойство: в отличие от большинства резервуаров для жидкостей, которые могут хранить только один тип жидкости, интерфейсы могут хранить до 9, а также предметы. Это фактически маленькие сундуки/многофункциональные резервуары, с дополнительной функциональностью, которую можно отключить, отключив их от сети."
]
quest.774B1D4152A0B4ED.quest_desc: ["Используется в основном для сборки мультиблоков при клике по среднему блоку."]
quest.776451A1A5F3B2FB.quest_desc: ["Поместите Электрический измеритель на участок цепи для измерения различных показателей. Точные значения можно просмотреть через очки, а измеряемое количество изменить с помощью гаечного ключа."]
quest.77B2C22D776D1B60.quest_desc: ["Соединяет блоки, совместимые с Forge Energy, проводами для передачи энергии."]
quest.77C016A83AD73399.quest_desc: ["Позволяет игроку управлять Латунным Дроном"]
quest.77C3D285E52CCA0E.quest_desc: ["Скатерти можно использовать для продажи предметов другим игрокам."]
quest.78019E2925B93446.quest_desc: ["Ключевой механический компонент, который сжимает и направляет энергию внутри двигателя. Необходим для преобразования топлива или давления в плавное и стабильное вращательное движение."]
quest.785322C002100649.quest_subtitle: "Держите сеть в работе на скорости с подключенным приводным тормозом"
quest.785322C002100649.title: "Сверхмощный"
quest.78B6A586B9B0458C.quest_desc: [
"Core Sample Drill — блок высотой 3 блока, добавленный Immersive Engineering. Используется для определения, есть ли жилы минералов в чанке. После завершения работы кликом он выводит результат: жила найдена или нет. Если жила найдена, её необходимо извлечь с помощью Excavator Multiblock."
""
"Core Sample Drill требует RF через нижнюю часть машины. Требует 40 RF/t в течение 600 тиков, что эквивалентно 30 секундам и 24 000 RF за использование."
]
quest.78B6A586B9B0458C.title: "Core Sample Drill"
quest.78C3192B690B7691.quest_desc: ["Высокопроизводительный компонент, который сжимает поступающий воздух для увеличения мощности и эффективности двигателя. Повышает скорость, выход и общую производительность в продвинутых механических установках."]
quest.7917E75BBA3F0614.quest_desc: [
"Сначала используйте Display Link на Display Block, чтобы его связать. Затем установите на Source Block, с которого будет производиться считывание. Не каждый блок может быть дисплеем или источником."
""
"Правый клик по ссылке открывает интерфейс. Через него можно добавлять метки к выводимому тексту. Как только настройки интерфейса приняты, зеленый индикатор на Display Link начнет мигать, показывая передачу информации на дисплеи."
]
quest.794ED2661B8E4621.quest_desc: ["Позволяет игроку летать, двигаться и плавать быстрее. Работает с водой и топливом."]
quest.79E01F6906DA951A.quest_desc: ["Автоматически пополняет гаджеты и броню, использующую воду."]
quest.7A39B7C7B0EEBF4F.quest_desc: ["Кристаллизованное энергетическое ядро, насыщенное эссенцией Fluix. Служит ключевым компонентом для крафта продвинутых сетевых устройств, хранилищ и беспроводных систем."]
quest.7A4D01AF34BB7E0E.quest_subtitle: "Кликните правой кнопкой по промышленному миксеру, чтобы установить его."
quest.7AA7094E591A373B.quest_desc: ["Редуктор со всеми 4 сторонами, вращающимися в одном направлении."]
quest.7AE502EDB73BD57A.quest_desc: [
"Crusher дробит, среди прочего, комки в грязные порошки, слитки в порошки и биомассу в биотопливо."
""
"По умолчанию потребляет 50 J/t и обрабатывает один предмет каждые 10 секунд."
]
quest.7AE502EDB73BD57A.quest_subtitle: "Время дробить"
quest.7AEE26C5734D4C0D.quest_desc: ["Инструмент Engineer's Wire Cutters используется для снятия проводов с блока с помощью правого клика. При использовании инструмента провод выпадет и его можно подобрать и использовать повторно."]
quest.7B0764DDE94E73D0.quest_desc: [
"Используя некоторые ванильные механики и &o&b2&r &aFission Reactor Logic Adapters&r, мы можем создать простой автоматический выключатель цепи, который срабатывает и отключает &cреактор&r &o&в случае если что-то выходит из-под контроля&r."
""
"Для этого нам понадобится один кусок редстоуна, поршень, блок песка или гравия и Обсервер."
""
"На одной из граней установим &aLogic Adapter&r, пропустим один блок над ним и установим второй Adapter. Верхний Adapter настроим на &9"Activation"&r, нижний на &c"Damage Critical"&r."
""
"Далее, перед нижним Adapter и под ним, поставьте любой строительный блок и подключите к нему кусок редстоуна от Adapter. Затем установим поршень вверх перед этим редстоуном и поставим на поршень песок или гравий."
""
"{@pagebreak}"
"Для финальной части выключателя установите Обсервер лицевой стороной наружу к &7поршневой&r конструкции. Это &nважно&r!"
""
"{image:kubejs:textures/item/example_circuit.png width:80 height:130 align:1}"
""
"Когда у реактора критическое повреждение, срабатывает нижний Adapter, что передает сигнал редстоуну, который активирует поршень и поднимает гравий/песок. Это активирует Обсервер, который затем отключает реактор."
]
quest.7B0764DDE94E73D0.title: "Автоматический выключатель цепи"
quest.7B5DF264A026BBD0.quest_desc: ["Регулируемый цепной редуктор работает аналогично Encased Chain Drive, но может изменять скорость выхода при подаче редстоуна."]
quest.7B6E46D719CFB570.quest_desc: ["Предмет, используемый для хранения и крафта катушек с проводом. Является ключевым компонентом для производства электрических материалов и помогает продвигаться к автоматизации и генерации энергии в экосистеме Create."]
quest.7B7585BC5EAECAC7.quest_desc: [
"Для использования энергия подается через одну из трех черных точек питания. Как и многие другие мультиблок-машины Immersive Engineering, её можно включить или выключить через панель редстоуна (красная точка) на передней стороне."
""
"Есть GUI с 12 слотами ввода, 4 дополнительными (для сплавления) и 7 слотами вывода. Для работы нужно вручную вставить три графитовые электроды. Arc Furnace может плавить примерно 500 предметов, прежде чем электроды износятся и потребуют замены."
]
quest.7B7585BC5EAECAC7.title: "Дуговая печь"
quest.7C074B5E2A0EAA63.quest_desc: [
"Чтобы собрать поезд, он должен иметь как минимум один комплект управления, направленный вперед относительно станции, на которой поезд создается. Если требуется непрямой игроком кондуктор, за контролями должен быть установлен Blaze Burner или сиденье."
""
"На поезде Train Controls можно кликнуть правой кнопкой, чтобы взять управление поездом. Обычные движения игрока будут влиять на поезд. Используйте контролы снова или приседайте, чтобы остановиться. Держите влево или вправо на развилке, чтобы выбрать путь. Используйте колесо прокрутки для регулировки максимальной скорости. Держите прыжок, чтобы подойти и выровняться на станции. Если установлен Steam Whistle, нажмите клавишу бега, чтобы его использовать."
]
quest.7CC49360D07086B8.quest_desc: [
"Quantum Entangloporter из Mekanism — это машина, которая позволяет передавать жидкости/предметы/энергию/газ от одного Quantum Entangloporter к другому через канал."
""
"Вместимость:"
"Энергия: 102.4 MFE"
""
"Жидкость: 256000 mB"
""
"Газ: 8192000 mB"
""
"Тепло: бесконечно"
""
"Предметы: предметы передаются только если есть соединенные пути для них. Максимальная скорость передачи — 128 предметов в секунду, но простаивающие энтанглопротеры могут немного задерживаться, чтобы достичь этой максимальной скорости."
]
quest.7CC49360D07086B8.quest_subtitle: "Беспроводная передача энергии, газов, жидкостей, всего."
quest.7CE764054ECB1C45.quest_desc: [
"Преобразует 1 бревно в 6 досок."
""
"Мультиблок собирается с помощью Engineer's Hammer на центральном блоке из железного листа."
]
quest.7CE764054ECB1C45.title: "Лесопилка"
quest.7E17AB5A4492929E.quest_desc: [
"Каждый реактор использует &aУран&r где-то в качестве топлива, верно?"
""
"Для начала соберем &aУрановые слитки&r. Их нужно обработать в &9Enrichment Chamber&r, чтобы получить &eYellow Cake Uranium&r."
]
quest.7E17AB5A4492929E.quest_subtitle: "Конечно, используется уран"
quest.7E17AB5A4492929E.title: "&aУран"
quest.7E38ACDAC8ACD079.quest_desc: [
"&dME Storage Monitor&r — простой способ видеть текущий уровень указанного предмета."
""
"Существует несколько взаимодействий для изменения:"
""
"&bПравый клик&r с &aПредметом&r &nотобразит&r текущее количество хранимого предмета, если он не заблокирован"
""
"&bПравый клик&r с &7пустой рукой&r сбросит отображение, если оно &nне&r заблокировано"
""
"&bShift+Правый клик&r с &7пустой рукой&r переключает &nблокировку&r"
""
"&bПравый клик&r с &eГаечным ключом&r &nповорот&r монитора, если он заблокирован и на земле или потолке."
]
quest.7EA6B942D1294ED6.quest_desc: [
"&9Digital Miner&r можно настроить на добычу руды только в определенной области. Также его можно установить на &nшелковое касание&r руд, что увеличивает потребление энергии."
""
"Как и все другие &7Mekanism&r машины, &9Digital Miner&r может автоматически удалять руды из своего &einventory&r для автоматической обработки другими машинами."
""
"Эта машина &nможет добывать за вас&r!"
""
"Полностью настраиваемая, может заменять добытые блоки булыжником или любым другим блоком, который вы предоставите!"
]
quest.7EB1BE897B2B8C1A.quest_desc: ["Механический компонент, который перенаправляет вращательную силу вертикально, сохраняя направление вращения. Идеально для компактных конструкций, где пространство ограничено и требуется точное совмещение шестерен."]
quest.7EE37ABD9F8B873D.quest_desc: [
"Pattern Providers — основной способ взаимодействия вашей системы автокрафта с миром. Они толкают ингредиенты из своих шаблонов в соседние инвентари, а предметы можно вставлять в них для подачи в сеть. Часто канал можно сэкономить, направив выход машины обратно в соседний Pattern Provider (часто тот, который отправил ингредиенты), вместо использования ME Import Bus для подачи выхода машины в сеть."
""
"Важно: поскольку они толкают ингредиенты напрямую из хранилища в Crafting CPU, они фактически не хранят ингредиенты в своем инвентаре, поэтому нельзя извлекать их напрямую. Нужно, чтобы провайдер толкал в другой инвентарь (например, бочку), а затем из него уже подавать дальше."
""
"{@pagebreak}"
"Также важно: провайдер должен толкать ВСЕ ингредиенты одновременно, нельзя частями. Это можно использовать для оптимизации."
""
"Pattern Providers имеют специальное взаимодействие с интерфейсами подсетей: если интерфейс не модифицирован (нет предметов в слотах запроса), провайдер полностью пропускает интерфейс и толкает напрямую в хранилище подсети, не заполняя интерфейс партиями рецептов, и не вставляет следующую партию, пока в машине нет места. Это работает корректно с режимом блокировки: провайдер следит за слотами машины для ингредиентов, а не за слотами интерфейса."
]
quest.7EE37ABD9F8B873D.title: "ME Pattern Provider"
quest.7F38E9C6DA5B99EA.quest_desc: ["&4Flamethrower&r — это оружие дальнего действия, использующее газ &3Hydrogen&r в качестве топлива."]
quest.7F5D32DA7E8D094F.quest_desc: ["{ "text": "Нажми меня!", "underlined": true, "clickEvent": { "action": "change_page", "value": "35639D4A6DDF6FF9" } }"]
quest.7F64AD61416A9157.quest_desc: [
"Установите буровую машину на найденный кусок жилы руды и поставьте на неё бур."
""
"Руда/жидкость выйдет через выход мультиблока."
""
"Жидкость можно извлечь через медную трубу."
""
"Для работы машине требуется RPM."
]
quest.7F783DD7214B96B2.quest_desc: [
"Energy Acceptor преобразует энергию из внешних систем (например, Redstone Flux RF) в AE и хранит её в сети."
""
"Коэффициент конверсии: 2 FE/RF = 1 AE"
""
"Чтобы увидеть текущую статистику энергии вашей сети, кликните правой кнопкой по любой её части с помощью Network Tool."
]
quest.7FAA4D4796F470A4.quest_desc: [
"Хранит до 1,000,000 AE."
""
"Они не принимают энергию напрямую, но используются для добавления дополнительного хранилища энергии в уже существующую ME-сеть."
]
